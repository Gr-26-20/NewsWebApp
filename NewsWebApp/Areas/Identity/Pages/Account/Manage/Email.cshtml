@page
@model EmailModel
@{
    ViewData["Title"] = "Email address";
    ViewData["ActivePage"] = ManageNavPages.Email;
}
<p class="account-kicker">STAY IN THE LOOP</p>
<h1>Email address</h1>
<p class="account-intro">We'll send a confirmation link to your new address before changing it.</p>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="account-email-line">
    <div><span>Current email</span><strong>@Model.Email</strong></div>
    <span class="account-badge">@(Model.IsEmailConfirmed ? "VERIFIED" : "NOT VERIFIED")</span>
</div>
<form id="email-form" method="post" asp-page-handler="ChangeEmail" class="account-form">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="mb-4">
        <label asp-for="Input.NewEmail" class="form-label">New email address</label>
        <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="you@example.com" />
        <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
    </div>
    <button id="change-email-button" type="submit" class="account-button">Send confirmation link →</button>
</form>
@if (!Model.IsEmailConfirmed)
{
    <div class="account-secondary-action">
        <p>Your current email hasn't been verified yet.</p>
        <form method="post" asp-page-handler="SendVerificationEmail">
            <button id="email-verification" type="submit" class="account-text-link">Resend verification email</button>
        </form>
    </div>
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
