@page
@model NewsWebApp.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Manage Users";
}

<div class="container mt-4">
    <h1>User Management</h1>
    <hr />

    @if (Model.UsersWithRoles.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Email</th>
                        <th>Roles</th>
                        
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.UsersWithRoles)
                    {
                        <tr>
                            
                            <td>
                                @if (!string.IsNullOrEmpty(user.RoleName))
                                {
                                    <span class="badge bg-success">@user.RoleName</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No roles</span>
                                }
                            </td>
                            <td>
                                <form method="post" style="display:inline;">
                                    <select name="role" class="form-select form-select-sm d-inline-block w-auto">
                                        <option value="">-- Add Role --</option>
                                        @foreach (var role in Model.AllRoles)
                                        {
                                            @if (!user.RoleName.Contains(role))
                                            {
                                                <option value="@role">@role</option>
                                            }
                                        }
                                    </select>
                                    <button type="submit" asp-page-handler="AddRole" asp-route-userId="@user.UserId" class="btn btn-sm btn-primary">Add</button>
                                </form>
                                @foreach (var role in new List<string> { user.RoleName }.Where(r => !string.IsNullOrEmpty(r)))
                                {
                                    <form method="post" style="display:inline;">
                                        <button type="submit" asp-page-handler="RemoveRole" asp-route-userId="@user.UserId" asp-route-role="@role" class="btn btn-sm btn-danger">Remove @role</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p>No users found.</p>
    }
</div>