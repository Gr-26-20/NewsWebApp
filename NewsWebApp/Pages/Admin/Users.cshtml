@page
@model NewsWebApp.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Manage Users";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-4 fw-bold">User Management</h1>
            <p class="lead text-muted">Manage user roles and permissions</p>
            <hr class="bg-primary" style="height: 3px;">
        </div>
    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Error Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Info Message -->
    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="bi bi-info-circle"></i>
            @TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.UsersWithRoles.Any())
    {
        <div class="row">
            <div class="col-12">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th class="text-start">
                                    <i class="bi bi-envelope"></i> Email
                                </th>
                                <th class="text-center">
                                    <i class="bi bi-shield-check"></i> Current Role
                                </th>
                                <th class="text-center">
                                    <i class="bi bi-gear"></i> Actions
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.UsersWithRoles)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @user.Email
                                    </td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(user.RoleName))
                                        {
                                            <span class="badge bg-success px-3 py-2">@user.RoleName</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-3 py-2">No roles</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <form method="post" asp-page-handler="AddRole" class="d-inline me-2">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.UserId" />
                                            <select name="role" class="form-select form-select-sm d-inline-block w-auto me-2" onchange="this.form.submit()">
                                                <option value="">-- Add Role --</option>
                                                @foreach (var role in Model.AllRoles)
                                                {
                                                    @if (!user.RoleName.Contains(role))
                                                    {
                                                        <option value="@role">@role</option>
                                                    }
                                                }
                                            </select>
                                        </form>
                                        @if (!string.IsNullOrEmpty(user.RoleName))
                                        {
                                            <form method="post" asp-page-handler="RemoveRole" class="d-inline" onsubmit="return confirm('Are you sure?')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@user.UserId" />
                                                <input type="hidden" name="role" value="@user.RoleName" />
                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    <i class="bi bi-trash"></i> Remove @user.RoleName
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="bi bi-info-circle"></i>
            <strong>No users found.</strong>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.05);
    }

    hr.bg-primary {
        border: none;
        margin-bottom: 2rem;
    }
</style>