@page
@model NewsWebApp.Pages.ProfileModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <!-- Profile Header -->
            <div class="card shadow-lg mb-4">
                <div class="card-header bg-primary text-white">
                    <h1 class="mb-0">
                        <i class="bi bi-person-circle"></i> My Profile
                    </h1>
                </div>

                <!-- Success Message -->
                @if (TempData["Message"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                        <i class="bi bi-check-circle"></i>
                        @TempData["Message"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- Error Messages -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger mt-3" role="alert">
                        <i class="bi bi-exclamation-triangle"></i>
                        <strong>Errors occurred:</strong>
                        <ul class="mb-0">
                            @foreach (var modelState in ViewData.ModelState.Values)
                            {
                                @foreach (var error in modelState.Errors)
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            }
                        </ul>
                    </div>
                }

                <div class="card-body">
                    <!-- User Information Section -->
                    <div class="mb-4">
                        <h5 class="card-title mb-3">
                            <i class="bi bi-info-circle"></i> User Information
                        </h5>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Email Address</label>
                                <div class="form-control-plaintext border-bottom pb-2">
                                    <i class="bi bi-envelope"></i> @Model.CurrentUser.Email
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">User ID</label>
                                <div class="form-control-plaintext border-bottom pb-2">
                                    <small class="text-muted">@Model.CurrentUser.Id</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Roles Section -->
                    <div class="mb-4">
                        <h5 class="card-title mb-3">
                            <i class="bi bi-shield-check"></i> Your Roles
                        </h5>
                        <div>
                            @if (Model.UserRoles.Any())
                            {
                                @foreach (var role in Model.UserRoles)
                                {
                                    <span class="badge bg-success me-2 px-3 py-2">@role</span>
                                }
                            }
                            else
                            {
                                <span class="badge bg-secondary px-3 py-2">No roles assigned</span>
                            }
                        </div>
                    </div>

                    <!-- Edit Profile Form -->
                    <form method="post" asp-page-handler="UpdateProfile">
                        <div class="mb-4">
                            <h5 class="card-title mb-3">
                                <i class="bi bi-pencil-square"></i> Edit Profile
                            </h5>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label for="firstName" class="form-label fw-semibold">First Name</label>
                                    <input type="text" class="form-control" id="firstName" name="firstName" 
                                           value="@Model.CurrentUser.FirstName" placeholder="Enter first name" required>
                                </div>
                                <div class="col-md-6">
                                    <label for="lastName" class="form-label fw-semibold">Last Name</label>
                                    <input type="text" class="form-control" id="lastName" name="lastName" 
                                           value="@Model.CurrentUser.LastName" placeholder="Enter last name" required>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="phoneNumber" class="form-label fw-semibold">Phone Number</label>
                                <input type="tel" class="form-control" id="phoneNumber" name="phoneNumber" 
                                       value="@Model.CurrentUser.PhoneNumber" placeholder="Enter phone number" required>
                            </div>
                        </div>

                        <!-- Form Actions -->
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg"></i> Update Profile
                            </button>
                            <a href="@Url.Page("/Index")" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Additional Actions -->
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0">
                        <i class="bi bi-gear"></i> Account Settings
                    </h6>
                </div>
                <div class="card-body">
                    <p class="text-muted">
                        <small>Need to change your password or manage security settings?</small>
                    </p>
                    <a href="@Url.Page("/Account/Manage/ChangePassword", new { area = "Identity" })" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-lock"></i> Change Password
                    </a>
                    <a href="@Url.Page("/Account/Manage/Index", new { area = "Identity" })" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-person-gear"></i> Security Settings
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>


