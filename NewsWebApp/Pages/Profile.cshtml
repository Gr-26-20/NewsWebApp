@page
@model NewsWebApp.Pages.ProfileModel
@{
    ViewData["Title"] = "My Account";
    var subscription = Model.Subscription;
    var periodEnd = subscription?.CurrentPeriodEndUtc ?? subscription?.CreatedAt?.AddDays(subscription.DurationInDays);
}
<div class="account-page">
    <partial name="/Views/Shared/_AccountHeader.cshtml" />
    <div class="account-grid">
        <aside><partial name="/Views/Shared/_AccountNav.cshtml" /></aside>
        <div class="account-content">
            <section class="account-panel">
                <p class="account-kicker">STAY BAITED WITH CLICKS</p>
                <h1>My profile</h1>
                <p class="account-intro">Keep your details up to date and make yourself at home.</p>

                @if (TempData["Message"] is string message)
                { 
                    <div class="account-notice" role="status">@message</div> 
                }
                    <div class="account-email-line"><span>Signed in as</span><strong>@Model.CurrentUser.Email</strong></div>
                    <form method="post" asp-page-handler="UpdateProfile" class="account-form">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="account-field-row">
                        <div class="mb-3">
                            <label asp-for="Input.FirstName" class="form-label"></label>
                            <input asp-for="Input.FirstName" class="form-control" autocomplete="given-name" />
                            <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.LastName" class="form-label"></label>
                            <input asp-for="Input.LastName" class="form-control" autocomplete="family-name" />
                            <span asp-validation-for="Input.LastName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Input.PhoneNumber" class="form-label"></label>
                        <input asp-for="Input.PhoneNumber" class="form-control" autocomplete="tel" type="tel" />
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                    </div>
                    <button type="submit" class="account-button">Save my details →</button>
                </form>
            </section>
            <section class="account-panel account-subscription-summary">
                <div class="account-section-heading">
                    <div><p class="account-kicker">YOUR READING, UPGRADED</p><h2>My subscription</h2></div>
                    <span class="account-badge">@(subscription is null ? "FREE READER" : subscription.CancelAtPeriodEnd ? "ENDS AT PERIOD CLOSE" : "PREMIUM ACTIVE")</span>
                </div>
                @if (subscription is not null)
                {
                    <p>@subscription.Name</p>
                    <p class="account-intro">@(subscription.CancelAtPeriodEnd ? "Access until" : subscription.StripeStatus is null ? "Expires" : "Renews on") @periodEnd?.ToString("dd MMM yyyy")</p>
                }
                else
                {
                    <p class="account-intro">Your account is ready. Explore premium for more reading.</p>
                }
                <div class="account-actions">
                    <a class="account-button account-button-secondary" asp-area="" asp-controller="Subscription" asp-action="MySubscription">View subscription →</a>
                    @if (Model.CurrentUser.StripeCustomerId is not null)
                    {
                        <form asp-area="" asp-controller="Subscription" asp-action="ManageBilling" method="post">
                            <button class="account-text-link" type="submit">Manage billing / cancel</button>
                        </form>
                    }
                    else if (subscription is null)
                    {
                        <a class="account-text-link" asp-area="" asp-controller="Subscription" asp-action="Index">Explore premium</a>
                    }
                </div>
            </section>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
