@model NewsWebApp.Models.ViewModels.AnalyticsChartViewModel
@using System.Globalization
@{
    var known = Model.Points.Where(p => p.Value.HasValue).ToList();
    var maximum = Math.Max(1L, known.Select(p => p.Value!.Value).DefaultIfEmpty(0).Max());
    const double left = 55, top = 20, plotWidth = 600, plotHeight = 220;
    var slot = plotWidth / Math.Max(1, Model.Points.Count);
    string Coordinate(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);
}
@if (known.Count == 0)
{
    <p class="text-muted">No telemetry is available for this chart.</p>
}
else
{
    <svg viewBox="0 0 680 290" role="img" aria-label="@Model.Title. Exact values are listed in daily totals." style="width:100%;height:auto">
        <title>@Model.Title</title>
        @for (var tick = 0; tick <= 4; tick++)
        {
            var y = top + plotHeight - tick * plotHeight / 4;
            var label = maximum * tick / 4d;
            <line x1="@Coordinate(left)" y1="@Coordinate(y)" x2="@Coordinate(left + plotWidth)" y2="@Coordinate(y)" stroke="#e2e6ea" />
            <g><text x="@Coordinate(left - 8)" y="@Coordinate(y + 4)" text-anchor="end" fill="#606770" font-size="11">@label.ToString("0.#", CultureInfo.InvariantCulture)</text></g>
        }
        @for (var i = 0; i < Model.Points.Count; i++)
        {
            var point = Model.Points[i];
            var x = left + i * slot + slot * .12;
            if (point.Value.HasValue)
            {
                var height = plotHeight * point.Value.Value / maximum;
                <rect x="@Coordinate(x)" y="@Coordinate(top + plotHeight - height)" width="@Coordinate(slot * .76)" height="@Coordinate(height)" fill="@Model.Color">
                    <title>@point.DateUtc.ToString("yyyy-MM-dd"): @point.Value.Value.ToString("N0")</title>
                </rect>
            }
            if (i == 0 || i == Model.Points.Count - 1 || (Model.Points.Count > 10 && i == Model.Points.Count / 2))
            {
                <g><text x="@Coordinate(left + (i + .5) * slot)" y="265" text-anchor="middle" fill="#606770" font-size="11">@point.DateUtc.ToString("dd MMM", CultureInfo.InvariantCulture)</text></g>
            }
        }
    </svg>
}

