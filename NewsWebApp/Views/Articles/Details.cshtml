@model NewsWebApp.Models.Articles

@{
    ViewData["Title"] = Model.Title;
}

<div class="article-page">

    <div class="section-title">
        <h2>@Model.Category.ToUpper()</h2>
        <a href="/">BACK TO NEWS →</a>
    </div>

    <article class="article-detail">

        <div class="story-category">
            @Model.Category
        </div>

        <h1>@Model.Title</h1>

        <p class="article-summary">
            @Model.Summary
        </p>

        <div class="article-meta">
            @Model.CreatedAt?.ToString("dd MMMM yyyy").ToUpper()
            &nbsp; | &nbsp;
            @Model.Category.ToUpper()
            &nbsp; | &nbsp;
            @Model.Author
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl"
                 alt="@Model.Title"
                 class="article-image" />
        }
        else
        {
            <div class="image-placeholder article-image">
                IMAGE
            </div>
        }

        <div class="article-content">

            @foreach (var paragraph in Model.Content.Split(
                new[] { "\r\n\r\n", "\n\n" },
                StringSplitOptions.RemoveEmptyEntries))
            {
                <p>
                    @paragraph
                </p>
            }

        </div>

        <div class="article-stats">
            <span>♥ @Model.Likes LIKES</span>
            <span>👁 @Model.Views VIEWS</span>
        </div>

    </article>

</div>