@model NewsWebApp.Models.Articles

@{
    ViewData["Title"] = Model.Title;
}

<div class="article-page">

    <div class="section-title">
        <h2>@Model.Category.ToUpper()</h2>
        <a href="/">BACK TO NEWS →</a>
    </div>

    <div class="article-detail-layout">

        <article class="article-detail">

            <div class="story-category">
                @Model.Category
            </div>

            <h1>@Model.Title</h1>

            <p class="article-summary">
                @Model.Summary
            </p>

            <div class="article-meta">
                @Model.CreatedAt?.ToString("dd MMMM yyyy").ToUpper()
                &nbsp; | &nbsp;
                @Model.Category.ToUpper()
                &nbsp; | &nbsp;
                @Model.Author
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl"
                     alt="@Model.Title"
                     class="article-image"
                     crossorigin="anonymous"/>
            }
            else
            {
                <div class="image-placeholder article-image">
                    IMAGE
                </div>
            }


<div class="article-content">

    @{
        var paragraphs = (Model.Content ?? string.Empty).Split(
            new[] { "\r\n\r\n", "\n\n" },
            StringSplitOptions.RemoveEmptyEntries);

        int paragraphCount = paragraphs.Length;

        int secondaryPosition = paragraphCount > 1
            ? (int)Math.Ceiling(paragraphCount / 3.0)
            : 1;

        int thirdPosition = paragraphCount > 2
            ? (int)Math.Ceiling(paragraphCount * 2.0 / 3.0)
            : paragraphCount;
    }

    @for (int i = 0; i < paragraphCount; i++)
    {
        <p style="white-space: pre-line;">@paragraphs[i]</p>

        @if (i + 1 == secondaryPosition &&
             !string.IsNullOrWhiteSpace(Model.SecondaryImageUrl))
        {
            <figure class="article-inline-figure">
                <img src="@Model.SecondaryImageUrl"
                     alt="@Model.SecondaryImageCaption"
                     class="article-inline-image"
                     crossorigin="anonymous" />

                @if (!string.IsNullOrWhiteSpace(Model.SecondaryImageCaption))
                {
                    <figcaption>@Model.SecondaryImageCaption</figcaption>
                }
            </figure>
        }

        @if (i + 1 == thirdPosition &&
             !string.IsNullOrWhiteSpace(Model.ThirdImageUrl))
        {
            <figure class="article-inline-figure">
                <img src="@Model.ThirdImageUrl"
                     alt="@Model.ThirdImageCaption"
                     class="article-inline-image"
                     crossorigin="anonymous" />

                @if (!string.IsNullOrWhiteSpace(Model.ThirdImageCaption))
                {
                    <figcaption>@Model.ThirdImageCaption</figcaption>
                }
            </figure>
        }
    }

    @if (paragraphCount == 0)
    {
        @if (!string.IsNullOrWhiteSpace(Model.SecondaryImageUrl))
        {
            <figure class="article-inline-figure">
                <img src="@Model.SecondaryImageUrl"
                     alt="@Model.SecondaryImageCaption"
                     class="article-inline-image"
                     crossorigin="anonymous" />
                @if (!string.IsNullOrWhiteSpace(Model.SecondaryImageCaption))
                {
                    <figcaption>@Model.SecondaryImageCaption</figcaption>
                }
            </figure>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ThirdImageUrl))
        {
            <figure class="article-inline-figure">
                <img src="@Model.ThirdImageUrl"
                     alt="@Model.ThirdImageCaption"
                     class="article-inline-image"
                     crossorigin="anonymous" />
                @if (!string.IsNullOrWhiteSpace(Model.ThirdImageCaption))
                {
                    <figcaption>@Model.ThirdImageCaption</figcaption>
                }
            </figure>
        }
    }

</div>


            <div class="article-stats">
                <button id="likeBtn" class="btn-like" onclick="likeArticle(@Model.Id)">
                    ♥ <span id="likeCount">@Model.Likes</span> LIKES
                </button>
                <span>👁 @Model.Views VIEWS</span>
            </div>

        </article>

        <aside class="article-advert-column">
            @await Component.InvokeAsync("Advertisement")
        </aside>

    </div>

</div>

<!-- Add the following script to handle the like button click event -->
@Html.AntiForgeryToken()
@section Scripts
{
    <script>
    async function likeArticle(id) {
        
        const response = await fetch(`/Articles/Like/${id}`, {
            method: 'POST',
           
        });
        const data = await response.json();
        document.getElementById('likeCount').textContent = data.likes;
        document.getElementById('likeBtn').disabled = true;
        document.getElementById('likeBtn').style.opacity = 0.5;
    }
    </script>
}
