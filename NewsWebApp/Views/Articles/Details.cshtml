@{
    ViewData["Title"] = "Main Headline Goes Here";
}

<div class="article-page">

    <div class="section-title">
        <h2>NEWS</h2>
        <a href="/">BACK TO NEWS →</a>
    </div>

    <article class="article-detail">

        <div class="story-category">NEWS</div>

        <h1>MAIN HEADLINE GOES HERE</h1>

        <p class="article-summary">
            This is a short introduction to the main news story.
        </p>

        <div class="article-meta">
            04 SEPTEMBER 2026 &nbsp; | &nbsp; NEWS
        </div>

        <div class="image-placeholder article-image">
            IMAGE
        </div>

        <div class="article-content">

            <p>
                This is the beginning of the full news article.
                The article detail page displays the complete story
                selected by the reader.
            </p>

            <p>
                This is another paragraph of the article. For now,
                this text is hard-coded so that we can test the
                article view and navigation before connecting it
                to the database.
            </p>

            <p>
                Additional article content would appear here.
                Later, this content will come from the Article
                model and database.
            </p>

        </div>

        <div class="article-stats">
            <span>♥ 0 LIKES</span>
            <span>👁 0 VIEWS</span>
        </div>

    </article>

</div>