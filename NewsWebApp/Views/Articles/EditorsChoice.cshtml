@model List<NewsWebApp.Models.Articles>

@{
    ViewData["Title"] = "Editor's Choice";
}

<partial name="_NavbarPartial" />


    <div class="section-title">
        <h2>EDITOR'S CHOICE</h2>
        <a href="/">BACK TO NEWS →</a>
    </div>

@* <h2 class="mb-4">Editor's Choice</h2> *@

@if (Model.Any())
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var article in Model)
        {
            <div class="col">
                <a href="@Url.Action("Details", "Articles", new { id = article.Id })" class="text-decoration-none text-reset">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrWhiteSpace(article.ImageUrl))
                        {
                            <img src="@article.ImageUrl" class="card-img-top" alt="@article.Title" style="height:180px; object-fit:cover;" />
                        }
                        else
                        {
                            <div class="card-img-top d-flex align-items-center justify-content-center bg-secondary text-white" style="height:180px;">
                                IMAGE
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">@article.Title</h5>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}
else
{
    <p>No Editor's Choice articles available.</p>
}
