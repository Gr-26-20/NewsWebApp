@model List<NewsWebApp.Models.Articles>

@{
    ViewData["Title"] = ViewBag.Category;
}

<div class="category-page">

    <!-- CATEGORY MENU -->
    <nav class="main-nav category-page-nav">

        <button class="navbar-toggler"
                type="button"
                onclick="toggleCategoryNavigation()"
                aria-label="Toggle categories">
            ☰
        </button>

        <div class="nav-categories category-page-categories"
             id="categoryPageCategories">

            <a href="/Categories/News">NEWS</a>
            <a href="/Categories/World">WORLD</a>
            <a href="/Categories/Sweden">SWEDEN</a>
            <a href="/Categories/Weather">WEATHER</a>
            <a href="/Categories/Sports">SPORTS</a>
            <a href="/Categories/EditorsChoice">EDITOR'S CHOICE</a>
            <a href="/Categories/Newsletter">NEWSLETTER</a>

        </div>

    </nav>


    <div class="section-title">
        <h2>@ViewBag.Category</h2>
        <a href="/">BACK TO NEWS →</a>
    </div>


    @if (ViewBag.Category == "WEATHER")
    {
        <div class="weather-category-link">
            <a asp-controller="Forecast" asp-action="Index">
                FULL FORECAST →
            </a>
        </div>
    }


    <section class="category-articles">

        @foreach (var article in Model)
        {
            <article class="category-article">

                @if (!string.IsNullOrWhiteSpace(article.ImageUrl))
                {
                    <img src="@article.ImageUrl"
                         alt="@article.Title"
                         class="article-image category-image"
                         data-focal-x="@article.ImageFocalPointX.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                         data-focal-y="@article.ImageFocalPointY.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                }
                else
                {
                    <div class="image-placeholder category-image">
                        IMAGE
                    </div>
                }

                <div class="story-category">
                    @article.Category
                </div>

                <h2>
                    <a href="/Articles/Details/@article.Id">
                        @article.Title
                    </a>
                </h2>

                <p>
                    @article.Summary
                </p>

            </article>
        }

    </section>

</div>


<script>
    function toggleCategoryNavigation() {
        document.getElementById("categoryPageCategories").classList.toggle("open");
    }

    


    function applyFocalPoints() {

        const images =
            document.querySelectorAll(".category-image[data-focal-x]");

        images.forEach(function (image) {

            const focalX =
                parseFloat(image.dataset.focalX);

            const focalY =
                parseFloat(image.dataset.focalY);

            if (isNaN(focalX) || isNaN(focalY)) {
                return;
            }

            if (!image.complete) {
                image.addEventListener("load", function () {
                    calculateObjectPosition(image, focalX, focalY);
                }, { once: true });

                return;
            }

            calculateObjectPosition(image, focalX, focalY);
        });
    }


    function calculateObjectPosition(image, focalX, focalY) {

        const imageWidth = image.naturalWidth;
        const imageHeight = image.naturalHeight;

        const containerWidth = image.clientWidth;
        const containerHeight = image.clientHeight;

        if (!imageWidth || !imageHeight ||
            !containerWidth || !containerHeight) {
            return;
        }

        const imageRatio =
            imageWidth / imageHeight;

        const containerRatio =
            containerWidth / containerHeight;

        const visibleWidth =
            Math.min(1, containerRatio / imageRatio);

        const visibleHeight =
            Math.min(1, imageRatio / containerRatio);

        let positionX =
            ((focalX / 100) - (visibleWidth / 2)) /
            (1 - visibleWidth);

        let positionY =
            ((focalY / 100) - (visibleHeight / 2)) /
            (1 - visibleHeight);

        if (visibleWidth >= 1) {
            positionX = 0.5;
        }

        if (visibleHeight >= 1) {
            positionY = 0.5;
        }

        positionX =
            Math.max(0, Math.min(1, positionX));

        positionY =
            Math.max(0, Math.min(1, positionY));

        image.style.objectPosition =
            `${positionX * 100}% ${positionY * 100}%`;
    }


    window.addEventListener("load", applyFocalPoints);
    window.addEventListener("resize", applyFocalPoints);
</script>