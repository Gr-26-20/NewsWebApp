 @model IEnumerable<NewsWebApp.Models.Feedback> 
@{
    ViewData["Title"] = "Details";
	<script src="~/Js/Feedback.js"></script>

}

<h1>Details</h1>


@{
    ViewData["Title"] = "Details";

	
}
@* @await Component.InvokeAsync("LatestNews")  *@
@if(ViewBag.FeedbackList != null)
{
	@foreach (var item in ViewBag.FeedbackList)
	{
		
		 <div class="card">
			<div class="card-header">
				<p><strong>Created At:</strong> @item.CreatedAt.ToString()</p>
				<p><strong>Updated at: </strong>@item.UpdatedAt</p>
			</div>
			<div class="card-body">
				<p>@item.Feedbackstring</p>
			</div>
			<div class="card-footer">
				<a class="btn btn-primary" asp-action="Edit" asp-controller="Editor" asp-route-id="@item.Id">Edit</a>
				<a class="btn btn-danger" asp-action="Delete" asp-controller="Editor" asp-route-id="@item.Id">Delete</a> 
				@* <button type="button" class="btn btn-danger" onclick="UpdateFeedback(@item.Id)">Delete</button> *@
				@* <button type="button" class="btn btn-outline-danger" onclick="UpdateFeedback(@item.Id)">Remove</button> *@
			 </div>
		 </div>  
	 }  

