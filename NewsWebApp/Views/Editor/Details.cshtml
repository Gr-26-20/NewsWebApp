 @model IEnumerable<NewsWebApp.Models.Feedback> 
@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>


@{
    ViewData["Title"] = "Details";

	
}

@if(Model != null)
{
	@await Component.InvokeAsync("Feedback")
	@foreach(var item in Model)
    {
		
		<div class="card">
			<div class="card-header">
				<p><strong>Created At:</strong> @item.CreatedAt.ToString()</p>
				<p><strong>Updated at: </strong>@item.UpdatedAt</p>
			</div>
			<div class="card-body">
				<p>@item.Feedbackstring</p>
			</div>
			<div class="card-footer">
			<a class="btn btn-primary" asp-action="Edit" asp-controller="Editor" asp-route-id="@item.Id">Edit</a>
			<a class="btn btn-danger" asp-action="Delete" asp-controller="Editor" asp-route-id="@item.Id">Delete</a>
			</div>
		</div>
    }
}

