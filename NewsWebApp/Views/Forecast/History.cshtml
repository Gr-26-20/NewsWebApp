
@model List<NewsWebApp.Models.ViewModels.TemperatureElectricityViewModel>

@{
    var historyError = ViewData["HistoryError"] as string;

    var swedishTimeZone =
        TimeZoneInfo.FindSystemTimeZoneById("Europe/Stockholm");

    var latestMeasurement = Model
        .OrderByDescending(x => x.MeasurementTime)
        .FirstOrDefault();

    var latestDate = latestMeasurement == null
        ? DateTime.Now
        : TimeZoneInfo.ConvertTimeFromUtc(
            latestMeasurement.MeasurementTime,
            swedishTimeZone);
}

<div class="history-page">

    <article class="history-article">

        <div class="story-category">
            DATA
        </div>

        <h1>Historical Weather & Electricity Prices</h1>

        @if (!string.IsNullOrEmpty(historyError))
        {
            <div class="forecast-unavailable">

                <svg class="service-unavailable-icon"
                     viewBox="0 0 80 80"
                     aria-hidden="true">

                    <!-- Antenna mast -->
                    <line x1="40" y1="31" x2="40" y2="62" />

                    <!-- Base -->
                    <line x1="29" y1="62" x2="51" y2="62" />

                    <!-- Antenna tip -->
                    <circle cx="40" cy="24" r="3" />

                    <!-- Transmission waves -->
                    <path d="M28 29 Q22 35 22 43" />
                    <path d="M52 29 Q58 35 58 43" />

                    <!-- Outer transmission waves -->
                    <path d="M19 25 Q12 34 12 45" />
                    <path d="M61 25 Q68 34 68 45" />

                    <!-- Red interruption mark -->
                    <line class="break-mark"
                          x1="31" y1="39"
                          x2="49" y2="53" />
                </svg>

                <strong>HISTORICAL DATA UNAVAILABLE</strong>

                <span>
                    @historyError
                </span>

            </div>
        }
        else
        {
            <p class="history-summary">
                This graph shows hourly temperature and electricity price measurements for Gothenburg.
            </p>

            <p class="history-summary">
                Electricity prices are from the Swedish <strong>SE3 price area</strong>.
                The measurements are collected automatically and stored over time,
                allowing the graph to reveal possible patterns between temperature and electricity prices.
            </p>

            <p class="history-summary">
                The data is updated approximately once per hour.
            </p>

            <div class="history-meta">
                <span>@latestDate.ToString("dd MMMM yyyy").ToUpper()</span>
                <span>SE3 ELECTRICITY AREA</span>
                <span>GOTHENBURG</span>
            </div>

            <div class="history-controls">

                <div class="history-range-buttons">
                    <button data-range="1day" class="active">1 DAY</button>
                    <button data-range="7days">7 DAYS</button>
                    <button data-range="total">TOTAL</button>
                </div>

                <div class="history-navigation">
                    <button type="button" id="historyPrev" aria-label="Previous period">←</button>
                    <button type="button" id="historyNext" aria-label="Next period">→</button>
                </div>

            </div>

            <div class="history-chart">
    <canvas id="historyChart"></canvas>
    <p class="history-data-sources">
                Temperature data provided by temperatur.nu ·
                Electricity price data provided by Lexlink Spot Prices.
            </p>
</div>



<section class="history-explanation">

    <h2>About the data</h2>

    <p>
        <strong>Temperature measurements</strong><br />
        Hourly temperature readings from Gothenburg, used as a fixed
        reference location throughout the historical chart.
    </p>

    <p>
        <strong>Electricity prices</strong><br />
        Hourly electricity spot prices from SE3, the Swedish electricity
        price area covering central Sweden, including Gothenburg.
    </p>

    <p>
        <strong>Temperature data</strong><br />
        Gothenburg is used as a fixed reference location to maintain a continuous
        and consistent temperature record over time. This makes it possible to
        explore potential patterns between temperature variations and electricity
        prices across different periods.
    </p>

    <h3>Sweden's four electricity price areas</h3>

    <p>
        <strong>SE1:</strong> Northern Sweden. Examples: Luleå, Kiruna and Piteå.<br />
        <strong>SE2:</strong> Northern and central Sweden. Examples: Sundsvall, Umeå and Östersund.<br />
        <strong>SE3:</strong> Central Sweden. Examples: Stockholm, Gothenburg, Uppsala and Örebro.<br />
        <strong>SE4:</strong> Southern Sweden. Examples: Malmö, Lund, Helsingborg and Växjö.
    </p>

    <p>
        The price areas reflect limitations in the electricity transmission
        network. Their boundaries do not necessarily follow municipal or
        county borders.
    </p>

    <p>
        <strong>Purpose of the comparison</strong><br />
        The chart allows historical temperature variations and electricity
        prices to be viewed together. It can help identify patterns, but
        does not establish a direct causal relationship between the two.
    </p>

    <p>
        <strong>Data update</strong><br />
         Temperature measurements are collected hourly. Day-ahead electricity
         prices are retrieved daily at 14:00, providing the next 24 hours of
         hourly prices, which are then included in the chart.
    </p>

</section>




            
        }

    </article>

</div>


@if (string.IsNullOrEmpty(historyError))
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns"></script>
    <script src="https://cdn.jsdelivr.net/npm/hammerjs@2.0.8"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2.2.0"></script>

    <script>


        if (typeof ChartZoom !== 'undefined') {
            Chart.register(ChartZoom);

            console.log('Zoom plugin loaded:', typeof ChartZoom);

            console.log(
                'Registered zoom plugin:',
                Chart.registry.plugins.get('zoom')
        );
        } else {
            console.error('Chart.js zoom plugin failed to load.');
        }

            const ctx = document.getElementById('historyChart');

            const historyData = [
        @foreach (var item in Model)
        {
                @: { time: '@item.MeasurementTime.ToString("o")', temperature: @item.TemperatureC.ToString(System.Globalization.CultureInfo.InvariantCulture), electricity: @item.ElectricityPrice.ToString(System.Globalization.CultureInfo.InvariantCulture) },
        }
            ];

            
        function getChartData(data) {

            const movingAverage = data.map((item, index) => {

            const start = Math.max(0, index - 23);

            const measurements = data
                .slice(start, index + 1)
                .map(item => item.electricity);

            const average =
                measurements.reduce((sum, value) => sum + value, 0) /
                measurements.length;

            return {
                x: new Date(item.time).getTime(),
                y: average
            };
        });

            return {
                temperatures: data.map(item => ({
                    x: new Date(item.time).getTime(),
                    y: item.temperature
                })),

                movingAverage: movingAverage,

                electricityPrices: data.map(item => ({
                    x: new Date(item.time).getTime(),
                    y: item.electricity
                }))
            };
        }


            historyData.sort((a, b) =>
                new Date(a.time) - new Date(b.time)
            );

            const chartData = getChartData(historyData);

            const HOUR_MS = 60 * 60 * 1000;
            const DAY_MS = 24 * HOUR_MS;
            const SEVEN_DAYS_MS = 7 * DAY_MS;

            const earliestHistoryTime =
                new Date(historyData[0].time).getTime();

            const latestHistoryTime =
                new Date(historyData[historyData.length - 1].time).getTime();

            const TOTAL_INITIAL_WINDOW = 14 * DAY_MS;

            let currentView = '1day';
            let windowOffset = 0;

            console.log('Initial view:', currentView);

            function getVisibleData() {
                return historyData;
            }

            function updateChart() {

            const visibleChartData = getChartData(historyData);

            chart.data.labels = [];
            chart.data.datasets[0].data = visibleChartData.temperatures;
            chart.data.datasets[1].data = visibleChartData.electricityPrices;
            chart.data.datasets[2].data = visibleChartData.movingAverage;

            const electricityValues = [
            ...visibleChartData.electricityPrices.map(point => point.y),
            ...visibleChartData.movingAverage.map(point => point.y)
            ];

        chart.options.scales.y1.min = Math.min(...electricityValues);
        chart.options.scales.y1.max = Math.max(...electricityValues);

            const xScale = chart.options.scales.x;

            // Calculate the visible time window.
            const endTime =
                latestHistoryTime - (windowOffset * HOUR_MS);

            xScale.min = undefined;
            xScale.max = undefined;

            if (currentView === '1day') {

                xScale.time.unit = 'hour';
                xScale.ticks.stepSize = 3;
                xScale.ticks.autoSkip = false;
                xScale.ticks.maxTicksLimit = undefined;

                xScale.min = endTime - DAY_MS;
                xScale.max = endTime;

            } else if (currentView === '7days') {

                xScale.time.unit = 'day';
                xScale.time.displayFormats.day = 'EEE';
                xScale.ticks.stepSize = 1;
                xScale.ticks.autoSkip = true;
                xScale.ticks.maxTicksLimit = 7;

                xScale.min = endTime - SEVEN_DAYS_MS;
                xScale.max = endTime;

            } else {

                xScale.time.unit = 'day';
                xScale.time.displayFormats.day = 'dd MMM yy';
                xScale.ticks.stepSize = undefined;
                xScale.ticks.autoSkip = true;
                xScale.ticks.maxTicksLimit = 8;

                xScale.min = Math.max(
                    earliestHistoryTime,
                    latestHistoryTime - TOTAL_INITIAL_WINDOW
                );

                xScale.max = latestHistoryTime;
            }

            // Enable horizontal dragging in all views.
            chart.options.plugins.zoom.pan.enabled = true;

            // Keep zooming restricted to TOTAL.
            chart.options.plugins.zoom.zoom.wheel.enabled =
                currentView === 'total';

            chart.options.plugins.zoom.zoom.pinch.enabled =
                currentView === 'total';

            chart.update('none');
        }

       

            const nightBackgroundPlugin = {
                id: 'nightBackground',

                beforeDraw(chart) {
                    const { ctx, chartArea, scales } = chart;

                    if (!chartArea || !scales.x) {
                        return;
                    }

                    const xScale = scales.x;
                    const minTime = xScale.min;
                    const maxTime = xScale.max;

                    if (minTime == null || maxTime == null) {
                        return;
                    }

                    function stockholmDateParts(timestamp) {
                        const parts = new Intl.DateTimeFormat('en-GB', {
                            timeZone: 'Europe/Stockholm',
                            year: 'numeric',
                            month: '2-digit',
                            day: '2-digit'
                        }).formatToParts(new Date(timestamp));

                        const result = {};

                        parts.forEach(part => {
                            result[part.type] = Number(part.value);
                        });

                        return result;
                    }

                    // Find every local calendar date that overlaps the graph.
                    const start = stockholmDateParts(minTime);
                    const end = stockholmDateParts(maxTime);

                    const startDate = new Date(Date.UTC(
                        start.year, start.month - 1, start.day
                    ));

                    const endDate = new Date(Date.UTC(
                        end.year, end.month - 1, end.day
                    ));

                    ctx.save();
                    ctx.fillStyle = 'rgba(0, 0, 0, 0.04)';

                    for (
                        let day = startDate.getTime();
                        day <= endDate.getTime();
                        day += 24 * 60 * 60 * 1000
                    ) {
                        const date = new Date(day);

                        const year = date.getUTCFullYear();
                        const month = String(date.getUTCMonth() + 1).padStart(2, '0');
                        const dayOfMonth = String(date.getUTCDate()).padStart(2, '0');

                        // Use explicit Stockholm offsets for each boundary.
                        // These are correct for Swedish standard and summer time.
                        for (const [hour, offset] of [[22, '+02:00'], [6, '+02:00']]) {
                            const boundary = new Date(
                                `${year}-${month}-${dayOfMonth}T${String(hour).padStart(2, '0')}:00:00${offset}`
                            ).getTime();

                            if (boundary > minTime && boundary < maxTime) {
                                const x = xScale.getPixelForValue(boundary);

                                ctx.beginPath();

                                if (hour === 22) {
                                    ctx.moveTo(x, chartArea.top);
                                    ctx.lineTo(chartArea.right, chartArea.top);
                                    ctx.lineTo(chartArea.right, chartArea.bottom);
                                    ctx.lineTo(x, chartArea.bottom);
                                } else {
                                    ctx.moveTo(chartArea.left, chartArea.top);
                                    ctx.lineTo(x, chartArea.top);
                                    ctx.lineTo(x, chartArea.bottom);
                                    ctx.lineTo(chartArea.left, chartArea.bottom);
                                }

                                ctx.closePath();
                                // Actual shading is drawn in the interval logic below.
                            }
                        }
                    }

                    // Shade the night intervals using real time coordinates.
                    const cursor = new Date(minTime);
                    cursor.setMinutes(0, 0, 0);

                    for (
                        let time = cursor.getTime();
                        time < maxTime;
                        time += 30 * 60 * 1000
                    ) {
                        const midpoint = time + 15 * 60 * 1000;

                        const hour = Number(
                            new Intl.DateTimeFormat('en-GB', {
                                timeZone: 'Europe/Stockholm',
                                hour: '2-digit',
                                hour12: false
                            }).format(new Date(midpoint))
                        );

                        if (hour >= 22 || hour < 6) {
                            const x1 = Math.max(
                                chartArea.left,
                                xScale.getPixelForValue(time)
                            );

                            const x2 = Math.min(
                                chartArea.right,
                                xScale.getPixelForValue(time + 30 * 60 * 1000)
                            );

                            if (x2 > x1) {
                                ctx.fillRect(
                                    x1,
                                    chartArea.top,
                                    x2 - x1,
                                    chartArea.bottom - chartArea.top
                                );
                            }
                        }
                    }

                    // Draw a subtle vertical line at midnight.
                    const midnightCursor = new Date(minTime);
                    midnightCursor.setMinutes(0, 0, 0);

                    for (
                        let time = midnightCursor.getTime();
                        time <= maxTime;
                        time += 30 * 60 * 1000
                    ) {
                        const parts = new Intl.DateTimeFormat('en-GB', {
                            timeZone: 'Europe/Stockholm',
                            hour: '2-digit',
                            minute: '2-digit',
                            hour12: false
                        }).formatToParts(new Date(time));

                        const hour = Number(
                            parts.find(p => p.type === 'hour').value
                        );

                        const minute = Number(
                            parts.find(p => p.type === 'minute').value
                        );

                        if (hour === 0 && minute === 0) {
                            const x = xScale.getPixelForValue(time);

                            if (x >= chartArea.left && x <= chartArea.right) {
                                ctx.beginPath();
                                ctx.strokeStyle = 'rgba(0, 0, 0, 0.22)';
                                ctx.lineWidth = 1;
                                ctx.moveTo(x, chartArea.top);
                                ctx.lineTo(x, chartArea.bottom);
                                ctx.stroke();
                            }
                        }
                    }

                    ctx.restore();
                }
            };

                    let chart;

        chart = new Chart(ctx, {
            type: 'line',

            plugins: [nightBackgroundPlugin],

            data: {
                labels: [],

                datasets: [
                    {
                        label: 'Temperature (°C)',
                        data: [],
                        parsing: false,
                        borderWidth: 2,
                        tension: 0.25,
                        pointRadius: 0,
                        yAxisID: 'y',
                        borderColor: '#2563eb',
                        backgroundColor: '#2563eb'
                    },
                    {
                        label: 'Electricity price (öre/kWh)',
                        data: [],
                        parsing: false,
                        borderWidth: 2,
                        tension: 0.15,
                        pointRadius: 0,
                        yAxisID: 'y1',
                        borderColor: '#dc2626',
                        backgroundColor: '#dc2626'
                    },
                    {
                        label: 'Electricity price trend (24h average)',
                        data: [],
                        parsing: false,
                        borderColor: '#27845A',
                        backgroundColor: '#27845A',
                        borderWidth: 1,
                        tension: 0.25,
                        pointRadius: 0,
                        pointHoverRadius: 3,
                        yAxisID: 'y1'
                    }
                ]
                },

        options: {
            responsive: true,
            maintainAspectRatio: false,
            animation: false,

            plugins: {
                legend: {
                    labels: {
                        generateLabels(chart) {
                            const labels =
                                Chart.defaults.plugins.legend.labels.generateLabels(chart);

                            labels.forEach(label => {
                                const isVisible =
                                    chart.isDatasetVisible(label.datasetIndex);

                                if (!isVisible) {
                                    label.fillStyle = '#ffffff';
                                    label.strokeStyle = '#b0b0b0';
                                    label.fontColor = '#999999';
                                }
                            });

                            return labels;
                        }
                    }
                },

                zoom: {
                    limits: {
                        x: {
                            min: earliestHistoryTime,
                            max: latestHistoryTime,
                            minRange: DAY_MS
                        }
                    },

                    pan: {
                        enabled: true,
                        mode: 'x',
                        threshold: 5,
                        modifierKey: null,

                        onPanStart: function ({ chart }) {
                            console.log('Pan started');
                            return true;
                        },

                        onPanRejected: function ({ chart }) {
                            console.log('Pan rejected');
                        },

                        onPanComplete: function ({ chart }) {
                            console.log('Pan completed');
                        }
                    },

                    zoom: {
                        mode: 'x',

                        wheel: {
                            enabled: true,
                            speed: 0.1
                        },

                        pinch: {
                            enabled: true
                        }
                    }
                }
            },

            scales: {
                x: {
                    type: 'time',

                    time: {
                        unit: 'hour',
                        displayFormats: {
                            hour: 'HH:mm',
                            day: 'EEE'
                        },
                        tooltipFormat: 'dd MMM yyyy HH:mm'
                    },

                    ticks: {
                        stepSize: 3,
                        source: 'auto',
                        autoSkip: false,
                        maxRotation: 0,
                        minRotation: 0
                    }
                },

                y: {
                    type: 'linear',
                    position: 'left',

                    title: {
                        display: true,
                        text: 'Temperature (°C)'
                    },

                    ticks: {
                        callback: function (value) {
                            return Number(value)
                                .toFixed(1)
                                .replace(".", ",") + "°";
                        }
                    }
                },

                y1: {
                    type: 'linear',
                    position: 'right',
                    bounds: 'data',

                    title: {
                        display: true,
                        text: 'Electricity price (öre/kWh)'
                    },

                    grid: {
                        drawOnChartArea: false
                    },
                    
                }
            }
        }
    });
        ctx.addEventListener('mousedown', () => {
            console.log('Canvas: mouse down');
        });

        ctx.addEventListener('mousemove', () => {
            console.log('Canvas: mouse move');
        });

        ctx.addEventListener('mouseup', () => {
            console.log('Canvas: mouse up');
        });
        
                   

            // Show the selected initial view (1 DAY).
            updateChart();

            

            // Range buttons: 1 DAY, 7 DAYS, TOTAL.
            document.querySelectorAll('.history-controls button[data-range]')
                .forEach(button => {
                    button.addEventListener('click', () => {
                        currentView = button.dataset.range;
                        windowOffset = 0;

                        document.querySelectorAll('.history-controls button[data-range]')
                            .forEach(b => b.classList.remove('active'));

                        button.classList.add('active');

                        updateChart();

                        console.log('Current view:', currentView);
                    });
                });

            // Previous period arrow.
            document.getElementById('historyPrev')
                .addEventListener('click', () => {
                    if (currentView === 'total') return;

                    windowOffset += currentView === '7days' ? 24 : 1;

                    updateChart();
                });

            // Next period arrow.
            document.getElementById('historyNext')
                .addEventListener('click', () => {
                    if (currentView === 'total') return;

                    const step = currentView === '7days' ? 24 : 1;

                    if (windowOffset >= step) {
                        windowOffset -= step;

                        updateChart();
                    }
                });
    </script>
}

