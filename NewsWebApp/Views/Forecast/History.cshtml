
@model List<NewsWebApp.Models.ViewModels.TemperatureElectricityViewModel>

@{
    var historyError = ViewData["HistoryError"] as string;

    var swedishTimeZone =
        TimeZoneInfo.FindSystemTimeZoneById("Europe/Stockholm");

    var latestMeasurement = Model
        .OrderByDescending(x => x.MeasurementTime)
        .FirstOrDefault();

    var latestDate = latestMeasurement == null
        ? DateTime.Now
        : TimeZoneInfo.ConvertTimeFromUtc(
            latestMeasurement.MeasurementTime,
            swedishTimeZone);
}

<div class="history-page">

    <article class="history-article">

        <div class="story-category">
            DATA
        </div>

        <h1>Historical Weather & Electricity Prices</h1>

        @if (!string.IsNullOrEmpty(historyError))
        {
            <div class="forecast-unavailable">

                <svg class="service-unavailable-icon"
                     viewBox="0 0 80 80"
                     aria-hidden="true">

                    <!-- Antenna mast -->
                    <line x1="40" y1="31" x2="40" y2="62" />

                    <!-- Base -->
                    <line x1="29" y1="62" x2="51" y2="62" />

                    <!-- Antenna tip -->
                    <circle cx="40" cy="24" r="3" />

                    <!-- Transmission waves -->
                    <path d="M28 29 Q22 35 22 43" />
                    <path d="M52 29 Q58 35 58 43" />

                    <!-- Outer transmission waves -->
                    <path d="M19 25 Q12 34 12 45" />
                    <path d="M61 25 Q68 34 68 45" />

                    <!-- Red interruption mark -->
                    <line class="break-mark"
                          x1="31" y1="39"
                          x2="49" y2="53" />
                </svg>

                <strong>HISTORICAL DATA UNAVAILABLE</strong>

                <span>
                    @historyError
                </span>

            </div>
        }
        else
        {
            <p class="history-summary">
                This graph shows hourly temperature and electricity price measurements for Gothenburg.
            </p>

            <p class="history-summary">
                Electricity prices are from the Swedish <strong>SE3 price area</strong>.
                The measurements are collected automatically and stored over time,
                allowing the graph to reveal possible patterns between temperature and electricity prices.
            </p>

            <p class="history-summary">
                The data is updated approximately once per hour.
            </p>

            <div class="history-meta">
                <span>@latestDate.ToString("dd MMMM yyyy").ToUpper()</span>
                <span>SE3 ELECTRICITY AREA</span>
                <span>GOTHENBURG</span>
            </div>

            <div class="history-controls">

                <div class="history-range-buttons">
                    <button data-range="1day" class="active">1 DAY</button>
                    <button data-range="7days">7 DAYS</button>
                    <button data-range="total">TOTAL</button>
                </div>

                <div class="history-navigation">
                    <button type="button" id="historyPrev" aria-label="Previous period">←</button>
                    <button type="button" id="historyNext" aria-label="Next period">→</button>
                </div>

            </div>

            <div class="history-chart">
                <canvas id="historyChart"></canvas>
            </div>
        }

    </article>

</div>


@if (string.IsNullOrEmpty(historyError))
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns"></script>

    <script>
            const ctx = document.getElementById('historyChart');

            const historyData = [
        @foreach (var item in Model)
        {
                @: { time: '@item.MeasurementTime.ToString("o")', temperature: @item.TemperatureC.ToString(System.Globalization.CultureInfo.InvariantCulture), electricity: @item.ElectricityPrice.ToString(System.Globalization.CultureInfo.InvariantCulture) },
        }
            ];

            function getChartData(data) {
                return {
                    temperatures: data.map(item => ({
                        x: new Date(item.time).getTime(),
                        y: item.temperature
                    })),

                    electricityPrices: data.map(item => ({
                        x: new Date(item.time).getTime(),
                        y: item.electricity
                    }))
                };
            }

            historyData.sort((a, b) =>
                new Date(a.time) - new Date(b.time)
            );

            const chartData = getChartData(historyData);

            const HOUR_MS = 60 * 60 * 1000;
            const DAY_MS = 24 * HOUR_MS;
            const SEVEN_DAYS_MS = 7 * DAY_MS;

            let currentView = '1day';
            let windowOffset = 0;

            console.log('Initial view:', currentView);

            function getVisibleData() {
                if (historyData.length === 0) {
                    return [];
                }

                if (currentView === 'total') {
                    return historyData;
                }

                const windowSize =
                    currentView === '1day'
                        ? DAY_MS
                        : SEVEN_DAYS_MS;

                const latestTime =
                    new Date(historyData[historyData.length - 1].time).getTime();

                const endTime =
                    latestTime - (windowOffset * HOUR_MS);

                const startTime =
                    endTime - windowSize;

                return historyData.filter(item => {
                    const time = new Date(item.time).getTime();

                    return time >= startTime && time <= endTime;
                });
            }

            function updateChart() {
                const visibleData = getVisibleData();
                const visibleChartData = getChartData(visibleData);

                chart.data.labels = [];
                chart.data.datasets[0].data = visibleChartData.temperatures;
                chart.data.datasets[1].data = visibleChartData.electricityPrices;

                chart.update('none');
            }

            const nightBackgroundPlugin = {
                id: 'nightBackground',

                beforeDraw(chart) {
                    const { ctx, chartArea, scales } = chart;

                    if (!chartArea || !scales.x) {
                        return;
                    }

                    const xScale = scales.x;
                    const minTime = xScale.min;
                    const maxTime = xScale.max;

                    if (minTime == null || maxTime == null) {
                        return;
                    }

                    function stockholmDateParts(timestamp) {
                        const parts = new Intl.DateTimeFormat('en-GB', {
                            timeZone: 'Europe/Stockholm',
                            year: 'numeric',
                            month: '2-digit',
                            day: '2-digit'
                        }).formatToParts(new Date(timestamp));

                        const result = {};

                        parts.forEach(part => {
                            result[part.type] = Number(part.value);
                        });

                        return result;
                    }

                    // Find every local calendar date that overlaps the graph.
                    const start = stockholmDateParts(minTime);
                    const end = stockholmDateParts(maxTime);

                    const startDate = new Date(Date.UTC(
                        start.year, start.month - 1, start.day
                    ));

                    const endDate = new Date(Date.UTC(
                        end.year, end.month - 1, end.day
                    ));

                    ctx.save();
                    ctx.fillStyle = 'rgba(0, 0, 0, 0.04)';

                    for (
                        let day = startDate.getTime();
                        day <= endDate.getTime();
                        day += 24 * 60 * 60 * 1000
                    ) {
                        const date = new Date(day);

                        const year = date.getUTCFullYear();
                        const month = String(date.getUTCMonth() + 1).padStart(2, '0');
                        const dayOfMonth = String(date.getUTCDate()).padStart(2, '0');

                        // Use explicit Stockholm offsets for each boundary.
                        // These are correct for Swedish standard and summer time.
                        for (const [hour, offset] of [[22, '+02:00'], [6, '+02:00']]) {
                            const boundary = new Date(
                                `${year}-${month}-${dayOfMonth}T${String(hour).padStart(2, '0')}:00:00${offset}`
                            ).getTime();

                            if (boundary > minTime && boundary < maxTime) {
                                const x = xScale.getPixelForValue(boundary);

                                ctx.beginPath();

                                if (hour === 22) {
                                    ctx.moveTo(x, chartArea.top);
                                    ctx.lineTo(chartArea.right, chartArea.top);
                                    ctx.lineTo(chartArea.right, chartArea.bottom);
                                    ctx.lineTo(x, chartArea.bottom);
                                } else {
                                    ctx.moveTo(chartArea.left, chartArea.top);
                                    ctx.lineTo(x, chartArea.top);
                                    ctx.lineTo(x, chartArea.bottom);
                                    ctx.lineTo(chartArea.left, chartArea.bottom);
                                }

                                ctx.closePath();
                                // Actual shading is drawn in the interval logic below.
                            }
                        }
                    }

                    // Shade the night intervals using real time coordinates.
                    const cursor = new Date(minTime);
                    cursor.setMinutes(0, 0, 0);

                    for (
                        let time = cursor.getTime();
                        time < maxTime;
                        time += 30 * 60 * 1000
                    ) {
                        const midpoint = time + 15 * 60 * 1000;

                        const hour = Number(
                            new Intl.DateTimeFormat('en-GB', {
                                timeZone: 'Europe/Stockholm',
                                hour: '2-digit',
                                hour12: false
                            }).format(new Date(midpoint))
                        );

                        if (hour >= 22 || hour < 6) {
                            const x1 = Math.max(
                                chartArea.left,
                                xScale.getPixelForValue(time)
                            );

                            const x2 = Math.min(
                                chartArea.right,
                                xScale.getPixelForValue(time + 30 * 60 * 1000)
                            );

                            if (x2 > x1) {
                                ctx.fillRect(
                                    x1,
                                    chartArea.top,
                                    x2 - x1,
                                    chartArea.bottom - chartArea.top
                                );
                            }
                        }
                    }

                    // Draw a subtle vertical line at midnight.
                    const midnightCursor = new Date(minTime);
                    midnightCursor.setMinutes(0, 0, 0);

                    for (
                        let time = midnightCursor.getTime();
                        time <= maxTime;
                        time += 30 * 60 * 1000
                    ) {
                        const parts = new Intl.DateTimeFormat('en-GB', {
                            timeZone: 'Europe/Stockholm',
                            hour: '2-digit',
                            minute: '2-digit',
                            hour12: false
                        }).formatToParts(new Date(time));

                        const hour = Number(
                            parts.find(p => p.type === 'hour').value
                        );

                        const minute = Number(
                            parts.find(p => p.type === 'minute').value
                        );

                        if (hour === 0 && minute === 0) {
                            const x = xScale.getPixelForValue(time);

                            if (x >= chartArea.left && x <= chartArea.right) {
                                ctx.beginPath();
                                ctx.strokeStyle = 'rgba(0, 0, 0, 0.22)';
                                ctx.lineWidth = 1;
                                ctx.moveTo(x, chartArea.top);
                                ctx.lineTo(x, chartArea.bottom);
                                ctx.stroke();
                            }
                        }
                    }

                    ctx.restore();
                }
            };

            let chart;

            chart = new Chart(ctx, {
                type: 'line',

                plugins: [nightBackgroundPlugin],

                data: {
                    labels: [],

                    datasets: [
                        {
                            label: 'Temperature (°C)',
                            data: [],
                            parsing: false,
                            borderWidth: 2,
                            tension: 0.25,
                            pointRadius: 2,
                            yAxisID: 'y'
                        },

                        {
                            label: 'Electricity price (öre/kWh)',
                            data: [],
                            parsing: false,
                            borderWidth: 2,
                            tension: 0.15,
                            pointRadius: 2,
                            yAxisID: 'y1'
                        }
                    ]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    scales: {
                        x: {
                            type: 'time',

                            time: {
                                unit: 'hour',
                                displayFormats: {
                                    hour: 'HH:mm'
                                },
                                tooltipFormat: 'dd MMM yyyy HH:mm'
                            },

                            ticks: {
                                stepSize: 3,
                                source: 'auto',
                                autoSkip: false,
                                maxRotation: 0,
                                minRotation: 0
                            }
                        },

                        y: {
                            type: 'linear',
                            position: 'left',

                            title: {
                                display: true,
                                text: 'Temperature (°C)'
                            },

                            ticks: {
                                callback: function (value) {
                                    return Number(value)
                                        .toFixed(1)
                                        .replace(".", ",") + "°";
                                }
                            }
                        },

                        y1: {
                            type: 'linear',
                            position: 'right',

                            title: {
                                display: true,
                                text: 'Electricity price (öre/kWh)'
                            },

                            grid: {
                                drawOnChartArea: false
                            }
                        }
                    }
                }
            });

            // Show the selected initial view (1 DAY).
            updateChart();

            // Range buttons: 1 DAY, 7 DAYS, TOTAL.
            document.querySelectorAll('.history-controls button[data-range]')
                .forEach(button => {
                    button.addEventListener('click', () => {
                        currentView = button.dataset.range;
                        windowOffset = 0;

                        document.querySelectorAll('.history-controls button[data-range]')
                            .forEach(b => b.classList.remove('active'));

                        button.classList.add('active');

                        updateChart();

                        console.log('Current view:', currentView);
                    });
                });

            // Previous period arrow.
            document.getElementById('historyPrev')
                .addEventListener('click', () => {
                    if (currentView === 'total') return;

                    windowOffset += currentView === '7days' ? 24 : 1;

                    updateChart();
                });

            // Next period arrow.
            document.getElementById('historyNext')
                .addEventListener('click', () => {
                    if (currentView === 'total') return;

                    const step = currentView === '7days' ? 24 : 1;

                    if (windowOffset >= step) {
                        windowOffset -= step;

                        updateChart();
                    }
                });
    </script>
}

