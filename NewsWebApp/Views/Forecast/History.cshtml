@model List<NewsWebApp.Models.ViewModels.TemperatureElectricityViewModel>
@{
    var swedishTimeZone =
        TimeZoneInfo.FindSystemTimeZoneById("Europe/Stockholm");
}

<h1>Historical Weather Data</h1>

<div style="max-width: 900px; height: 400px;">
    <canvas id="historyChart"></canvas>
</div>

<table>
    <thead>
        <tr>
            <th>Time</th>
            <th>Temperature</th>
            <th>Electricity Price</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                @{
                    var swedishTime =
                        TimeZoneInfo.ConvertTimeFromUtc(
                            item.MeasurementTime,
                            swedishTimeZone);
                }

                <td>@swedishTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>@item.TemperatureC °C</td>
                <td>@item.ElectricityPrice SEK/MWh</td>
            </tr>
        }
    </tbody>
</table>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const ctx = document.getElementById('historyChart');

        new Chart(ctx, {
        type: 'line',

        data: {
                labels: [
                    @foreach (var item in Model)
                    {
                            var swedishTime =
                                    TimeZoneInfo.ConvertTimeFromUtc(
                                            item.MeasurementTime,
                                            swedishTimeZone);

                            @: '@swedishTime.ToString("dd MMM HH:mm")',
                    }
                ],

            datasets: [
                {
                    label: 'Temperature (°C)',
                    data: [
                        @foreach (var item in Model)
                        {
                                @: @item.TemperatureC.ToString(System.Globalization.CultureInfo.InvariantCulture),
                        }
                    ],
                    borderWidth: 2,
                    yAxisID: 'y'
                },
                {
                    label: 'Electricity price (SEK/MWh)',
                    data: [
                        @foreach (var item in Model)
                        {
                                if (item.ElectricityPrice > 0)
                                {
                                        @: @item.ElectricityPrice.ToString(System.Globalization.CultureInfo.InvariantCulture),
                                }
                                else
                                {
                                        @: null,
                                }
                        }
                    ],
                    borderWidth: 2,
                    yAxisID: 'y1'
                }
            ]
        },

        options: {
            scales: {
                y: {
                    type: 'linear',
                    position: 'left',
                    title: {
                        display: true,
                        text: 'Temperature (°C)'
                    }
                },
                y1: {
                    type: 'linear',
                    position: 'right',
                    title: {
                        display: true,
                        text: 'Electricity price (SEK/MWh)'
                    },
                    grid: {
                        drawOnChartArea: false
                    }
                }
            }
        }
    });
</script>