
@model NewsWebApp.Models.ViewModels.ForecastViewModel

@{
    ViewData["Title"] = "Weather";

    string GetWeatherSymbol(WeatherForecast weather)
    {
        var code = weather.Icon?.Code?.ToLower() ?? "";

        if (code.EndsWith("n"))
        {
            if (code.StartsWith("01"))
                return "🌙";

            if (code.StartsWith("02"))
                return "☁️";

            if (code.StartsWith("03") || code.StartsWith("04"))
                return "☁️";
        }

        if (code.StartsWith("01"))
            return "☀️";

        if (code.StartsWith("02"))
            return "🌤️";

        if (code.StartsWith("03") || code.StartsWith("04"))
            return "☁️";

        if (code.StartsWith("09") || code.StartsWith("10"))
            return "🌧️";

        if (code.StartsWith("11"))
            return "⛈️";

        if (code.StartsWith("13"))
            return "❄️";

        if (code.StartsWith("50"))
            return "🌫️";

        return "🌤️";
    }
}

<div class="forecast-page">

    <div class="forecast-page-header">
        <h1>WEATHER</h1>

        <a href="/" class="section-link">BACK TO NEWS →</a>
    </div>


    <!-- CURRENT WEATHER -->

    @if (!string.IsNullOrEmpty(Model.HourlyForecastError))
    {
        <section class="current-weather">

            <div class="forecast-unavailable">

                <svg class="service-unavailable-icon"
                     viewBox="0 0 80 80"
                     aria-hidden="true">

                    <!-- Antenna mast -->
                    <line x1="40" y1="31" x2="40" y2="62" />

                    <!-- Base -->
                    <line x1="29" y1="62" x2="51" y2="62" />

                    <!-- Antenna tip -->
                    <circle cx="40" cy="24" r="3" />

                    <!-- Transmission waves -->
                    <path d="M28 29 Q22 35 22 43" />
                    <path d="M52 29 Q58 35 58 43" />

                    <!-- Outer transmission waves -->
                    <path d="M19 25 Q12 34 12 45" />
                    <path d="M61 25 Q68 34 68 45" />

                    <!-- Red interruption mark -->
                    <line class="break-mark"
                          x1="31" y1="39"
                          x2="49" y2="53" />
                </svg>

                <strong>WEATHER SERVICE UNAVAILABLE</strong>

                <span>
                    @Model.HourlyForecastError
                </span>

            </div>

        </section>
    }
    else
    {
        <section class="current-weather">

            <div class="current-weather-main">

                <div class="current-location">
                    @Model.HourlyForecast.FirstOrDefault()?.City
                </div>

                <div class="current-temperature">
                    @Model.HourlyForecast.FirstOrDefault()?.TemperatureC°C
                </div>

                <div class="current-condition">
                    @Model.HourlyForecast.FirstOrDefault()?.Summary
                </div>

            </div>

            <div class="current-weather-details">

                <div class="weather-detail">
                    <span>HUMIDITY</span>
                    <strong>
                        @Model.HourlyForecast.FirstOrDefault()?.Humidity%
                    </strong>
                </div>

                <div class="weather-detail">
                    <span>WIND</span>
                    <strong>
                        @Model.HourlyForecast.FirstOrDefault()?.WindSpeed m/s
                    </strong>
                </div>

            </div>

        </section>
    }


    <!-- NEXT 24 HOURS -->

    <section class="forecast-section">

        <div class="forecast-heading">
            <h2>NEXT 24 HOURS</h2>
        </div>

        @if (!string.IsNullOrEmpty(Model.HourlyForecastError))
        {
            <div class="forecast-unavailable">

                <svg class="service-unavailable-icon"
                     viewBox="0 0 80 80"
                     aria-hidden="true">

                    <!-- Antenna mast -->
                    <line x1="40" y1="31" x2="40" y2="62" />

                    <!-- Base -->
                    <line x1="29" y1="62" x2="51" y2="62" />

                    <!-- Antenna tip -->
                    <circle cx="40" cy="24" r="3" />

                    <!-- Transmission waves -->
                    <path d="M28 29 Q22 35 22 43" />
                    <path d="M52 29 Q58 35 58 43" />

                    <!-- Outer transmission waves -->
                    <path d="M19 25 Q12 34 12 45" />
                    <path d="M61 25 Q68 34 68 45" />

                    <!-- Red interruption mark -->
                    <line class="break-mark"
                          x1="31" y1="39"
                          x2="49" y2="53" />
                </svg>

                <strong>FORECAST SERVICE UNAVAILABLE</strong>

                <span>
                    @Model.HourlyForecastError
                </span>

            </div>
        }
        else
        {
            <!-- DESKTOP -->

            <div class="hourly-desktop">

                <div class="hourly-day">
                    TODAY
                </div>

                <div class="hourly-grid">

                    @foreach (var weather in Model.HourlyForecast)
                    {
                        <div class="hourly-column">

                            <strong class="hourly-time">
                                @weather.Date.ToString("HH:mm")
                            </strong>

                            <strong class="hourly-temperature">
                                @weather.TemperatureC°C
                            </strong>

                            <span class="hourly-symbol">
                                @GetWeatherSymbol(weather)
                            </span>

                            <span class="hourly-wind">
                                @weather.WindSpeed m/s
                            </span>

                            <span class="hourly-humidity">
                                @weather.Humidity%
                            </span>

                        </div>
                    }

                </div>

            </div>


            <!-- MOBILE -->

            <div class="hourly-mobile">

                @foreach (var weather in Model.HourlyForecast)
                {
                    <div class="forecast-row">

                        <strong>
                            @weather.Date.ToString("HH:mm")
                        </strong>

                        <span class="forecast-symbol">
                            @GetWeatherSymbol(weather)
                        </span>

                        <strong>
                            @weather.TemperatureC°C
                        </strong>

                        <span>
                            @weather.Summary
                        </span>

                    </div>
                }

            </div>
        }

    </section>


    <!-- 5 DAY FORECAST -->

    <section class="forecast-section">

        <div class="forecast-heading">
            <h2>
                @if (Model.FiveDayForecast.Count == 6)
                {
                    <text>TODAY & 5 DAY FORECAST</text>
                }
                else
                {
                    <text>5 DAY FORECAST</text>
                }
            </h2>
        </div>

        @if (!string.IsNullOrEmpty(Model.FiveDayForecastError))
        {
            <div class="forecast-unavailable">

                <svg class="service-unavailable-icon"
                     viewBox="0 0 80 80"
                     aria-hidden="true">

                    <!-- Antenna mast -->
                    <line x1="40" y1="31" x2="40" y2="62" />

                    <!-- Base -->
                    <line x1="29" y1="62" x2="51" y2="62" />

                    <!-- Antenna tip -->
                    <circle cx="40" cy="24" r="3" />

                    <!-- Transmission waves -->
                    <path d="M28 29 Q22 35 22 43" />
                    <path d="M52 29 Q58 35 58 43" />

                    <!-- Outer transmission waves -->
                    <path d="M19 25 Q12 34 12 45" />
                    <path d="M61 25 Q68 34 68 45" />

                    <!-- Red interruption mark -->
                    <line class="break-mark"
                          x1="31" y1="39"
                          x2="49" y2="53" />
                </svg>

                <strong>FORECAST SERVICE UNAVAILABLE</strong>

                <span>
                    @Model.FiveDayForecastError
                </span>

            </div>
        }
        else
        {
            <div class="five-day-forecast">

                @foreach (var weather in Model.FiveDayForecast)
                {
                    <div class="forecast-day">

                        <strong>
                            @weather.Date.ToString("ddd").ToUpper()
                        </strong>

                        <span>
                            @weather.TemperatureC°C
                        </span>

                        <small>
                            @weather.Summary
                        </small>

                    </div>
                }

            </div>
        }

        <div class="forecast-credit">
            Forecast data provided by DreamMaker IT · weatherapi.dreammaker-it.se
        </div>

    </section>


    <div class="history-link">

        <a asp-controller="Forecast"
           asp-action="History"
           class="section-link">
            HISTORICAL WEATHER & ELECTRICITY →
        </a>

    </div>

</div>

