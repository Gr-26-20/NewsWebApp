@model NewsWebApp.Models.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Home";
}

<div class="news-site">

    <!-- HEADER -->
    <header class="site-header">
        <div class="header-top">
            <span>@DateTime.Today.ToString("dddd / dd MMMM yyyy").ToUpper()</span>
            <span>LINKÖPING</span>
        </div>

        <div class="brand-row">
            <h1 class="site-logo">CLICKBAIT News</h1>
            <div class="brand-tagline">YOUR NEWS / YOUR CITY / YOUR WORLD</div>
        </div>

        <!-- MAIN CATEGORY NAVIGATION -->
        <nav class="main-nav">

            <button class="navbar-toggler"
                    type="button"
                    onclick="toggleNavigation()"
                    aria-label="Toggle navigation">
                ☰
            </button>

            <div class="nav-categories" id="navCategories">

                <a href="/Categories/News">NEWS</a>
                <a href="/Categories/World">WORLD</a>
                <a href="/Categories/Sweden">SWEDEN</a>
                <a href="/Categories/Weather">WEATHER</a>
                <a href="/Categories/Sports">SPORTS</a>
                <a href="/Categories/EditorsChoice">EDITOR'S CHOICE</a>
                <a href="/Categories/Newsletter">NEWSLETTER</a>
                <a asp-controller="Subscription"
                   asp-action="Index"
                   class="btn-subscribe-nav">
                    SUBSCRIBE
                </a>

            </div>
        </nav>
    </header>


    <!-- BREAKING NEWS -->
    <section class="breaking-bar">
        <strong>BREAKING</strong>
        <span>Breaking news headline goes here</span>
    </section>


    <!-- MAIN CONTENT -->
    <main>

        <!-- FEATURED NEWS -->
        <section class="section-block">

            <div class="section-title">
                <h2>NEWS</h2>
                <a href="/Categories/News">VIEW ALL →</a>
            </div>


            @if (Model.NewsArticles.Any())
            {
                <div class="featured-grid">

                    <!-- MAIN NEWS STORY -->
                    @{
                        var mainArticle = Model.NewsArticles.First();
                    }

                    <article class="featured-story">

                        @if (!string.IsNullOrWhiteSpace(mainArticle.ImageUrl))
                        {
                            <img src="@mainArticle.ImageUrl"
                                 alt="@mainArticle.Title"
                                 class="article-image large" />
                        }
                        else
                        {
                            <div class="image-placeholder large">
                                IMAGE
                            </div>
                        }

                        <div class="story-category">
                            @mainArticle.Category
                        </div>

                        <h3>
                            <a href="/Articles/Details/@mainArticle.Id">
                                @mainArticle.Title
                            </a>
                        </h3>

                        <p>
                            @mainArticle.Summary
                        </p>

                    </article>


                    <!-- SECONDARY NEWS STORIES -->
                    <div class="side-stories">

                        @foreach (var article in Model.NewsArticles.Skip(1))
                        {
                            <article class="story">

                                @if (!string.IsNullOrWhiteSpace(article.ImageUrl))
                                {
                                    <img src="@article.ImageUrl"
                                         alt="@article.Title"
                                         class="article-image secondary" />
                                }
                                else
                                {
                                    @if (!string.IsNullOrWhiteSpace(article.ImageUrl))
                                    {
                                        <img src="@article.ImageUrl"
                                             alt="@article.Title"
                                             class="article-image" />
                                    }
                                    else
                                    {
                                        <div class="image-placeholder">
                                            IMAGE
                                        </div>
                                    }
                                }

                                <div>

                                    <div class="story-category">
                                        @article.Category
                                    </div>

                                    <h3>
                                        <a href="/Articles/Details/@article.Id">
                                            @article.Title
                                        </a>
                                    </h3>

                                    <p>
                                        @article.Summary
                                    </p>

                                </div>

                            </article>
                        }

                    </div>


                    <!-- RIGHT SIDEBAR -->
                    <aside class="sidebar">

                        <h2>EDITOR'S CHOICE</h2>

                        <article class="sidebar-story">
                            <span>01</span>
                            <h3>EDITOR'S CHOICE STORY</h3>
                        </article>

                        <article class="sidebar-story">
                            <span>02</span>
                            <h3>EDITOR'S CHOICE STORY</h3>
                        </article>

                        <article class="sidebar-story">
                            <span>03</span>
                            <h3>EDITOR'S CHOICE STORY</h3>
                        </article>

                    </aside>

                </div>
            }
            else
            {
                <p>No news articles available.</p>
            }

        </section>


        <!-- CATEGORY ROWS -->
        <section class="category-section">


            <!-- WORLD -->
            <div class="category-column">

                <div class="section-title">
                    <h2>
                        <a href="/Categories/World">WORLD</a>
                    </h2>

                    <a href="/Categories/World">MORE →</a>
                </div>


                @if (Model.WorldArticles.Any())
                {
                    var article = Model.WorldArticles.First();

                    <article class="compact-story">

                        @if (!string.IsNullOrWhiteSpace(article.ImageUrl))
                        {
                            <img src="@article.ImageUrl"
                                 alt="@article.Title"
                                 class="article-image" />
                        }
                        else
                        {
                            <div class="image-placeholder">
                                IMAGE
                            </div>
                        }

                        <div>

                            <div class="story-category">
                                @article.Category
                            </div>

                            <h3>
                                <a href="/Articles/Details/@article.Id">
                                    @article.Title
                                </a>
                            </h3>

                            <p>
                                @article.Summary
                            </p>

                        </div>

                    </article>
                }
                else
                {
                    <p>No World articles available.</p>
                }

            </div>


            <!-- SWEDEN -->
            <div class="category-column">

                <div class="section-title">
                    <h2>
                        <a href="/Categories/Sweden">SWEDEN</a>
                    </h2>

                    <a href="/Categories/Sweden">MORE →</a>
                </div>


                @if (Model.SwedenArticles.Any())
                {
                    var article = Model.SwedenArticles.First();

                    <article class="compact-story">

                        @if (!string.IsNullOrWhiteSpace(article.ImageUrl))
                        {
                            <img src="@article.ImageUrl"
                                 alt="@article.Title"
                                 class="article-image" />
                        }
                        else
                        {
                            <div class="image-placeholder">
                                IMAGE
                            </div>
                        }

                        <div>

                            <div class="story-category">
                                @article.Category
                            </div>

                            <h3>
                                <a href="/Articles/Details/@article.Id">
                                    @article.Title
                                </a>
                            </h3>

                            <p>
                                @article.Summary
                            </p>

                        </div>

                    </article>
                }
                else
                {
                    <p>No Sweden articles available.</p>
                }

            </div>


            <!-- SPORTS -->
            <div class="category-column">

                <div class="section-title">
                    <h2>
                        <a href="/Categories/Sports">SPORTS</a>
                    </h2>

                    <a href="/Categories/Sports">MORE →</a>
                </div>


                @if (Model.SportsArticles.Any())
                {
                    var article = Model.SportsArticles.First();

                    <article class="compact-story">

                        @if (!string.IsNullOrWhiteSpace(article.ImageUrl))
                        {
                            <img src="@article.ImageUrl"
                                 alt="@article.Title"
                                 class="article-image" />
                        }
                        else
                        {
                            <div class="image-placeholder">
                                IMAGE
                            </div>
                        }

                        <div>

                            <div class="story-category">
                                @article.Category
                            </div>

                            <h3>
                                <a href="/Articles/Details/@article.Id">
                                    @article.Title
                                </a>
                            </h3>

                            <p>
                                @article.Summary
                            </p>

                        </div>

                    </article>
                }
                else
                {
                    <p>No Sports articles available.</p>
                }

            </div>

        </section>


        <!-- WEATHER -->
        <section class="weather-section">

            <div class="section-title">
                <h2>WEATHER</h2>
                <a href="#">FULL FORECAST →</a>
            </div>

            <div class="weather-placeholder">

                <div class="weather-city" id="weatherCity">
                    GOTHENBURG
                </div>

                <div id="weatherTemperature" class="weather-temp">
                    @Model.Weather?.Temp°
                </div>

                <div class="weather-info">
                    LIVE TEMPERATURE

                    <select id="weatherMunicipality"
                            class="weather-station-select">

                        @foreach (var municipality in Model.Municipalities)
                        {
                            <option value="@municipality.ApiValue">
                                @municipality.Name
                            </option>
                        }

                    </select>
                    

                    <select id="weatherStation"
                            class="weather-station-select">

                        @foreach (var station in Model.WeatherStations)
                        {
                            <option value="@station.Id">
                                @station.Title
                            </option>
                        }

                    </select>

                </div>

                <div class="weather-attribution">
                    Weather API provided by
                    <a href="https://www.temperatur.nu/"
                       target="_blank"
                       rel="noopener noreferrer">
                        temperatur.nu
                    </a>
                </div>

            </div>

        </section>

    </main>

</div>
@section Scripts {
    <script>
        document.getElementById("weatherStation").addEventListener("change", async function() {

            const stationId = this.value;

            const response = await fetch(`/Home/GetWeather?stationId=${stationId}`);

            if (!response.ok) {
                return;
            }

            const weather = await response.json();

            document.getElementById("weatherTemperature").textContent = weather.temp + "°";
        });


        document.getElementById("weatherMunicipality").addEventListener("change", async function() {

            const municipality = this.value;

            const municipalityName = this.options[this.selectedIndex].text;

            document.getElementById("weatherCity").textContent =
                municipalityName.toUpperCase();

            const response = await fetch(`/Home/GetStations?municipality=${municipality}`);

            if (!response.ok) {
                return;
            }

            const stations = await response.json();

            const stationSelect = document.getElementById("weatherStation");

            stationSelect.innerHTML = "";

            stations.forEach(function(station) {

                const option = document.createElement("option");

                option.value = station.id;
                option.textContent = station.title;

                stationSelect.appendChild(option);
            });

            if (stations.length > 0) {
                stationSelect.value = stations[0].id;

                const weatherResponse =
                    await fetch(`/Home/GetWeather?stationId=${stations[0].id}`);

                if (weatherResponse.ok) {
                    const weather = await weatherResponse.json();

                    document.getElementById("weatherTemperature").textContent =
                        weather.temp + "°";
                }
            }
        });
    </script>

}