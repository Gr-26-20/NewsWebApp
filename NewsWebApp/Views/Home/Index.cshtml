@model NewsWebApp.Models.ViewModels.HomeViewModel
@using Microsoft.AspNetCore.Identity
@inject SignInManager<NewsWebApp.Data.ApplicationUser> SignInManager
@inject UserManager<NewsWebApp.Data.ApplicationUser> UserManager
@inject NewsWebApp.Services.ISubscriptionService SubscriptionService



@{
    ViewData["Title"] = "Home";
}

<div class="news-site">

    <!-- HEADER -->
    <header class="site-header">
        <div class="header-top">
            <span>@DateTime.Today.ToString("dddd / dd MMMM yyyy").ToUpper()</span>
            <span>LINKÖPING</span>
        </div>

        <div class="brand-row">
            <h1 class="site-logo">CLICKBAIT News</h1>
            <div class="brand-tagline">YOUR NEWS / YOUR CITY / YOUR WORLD</div>
        </div>

        <!-- MAIN CATEGORY NAVIGATION -->
        <nav class="main-nav">

            <button class="navbar-toggler"
                    type="button"
                    onclick="toggleNavigation()"
                    aria-label="Toggle navigation">
                ☰
            </button>

            <div class="nav-categories" id="navCategories">

                <a href="/Categories/News">NEWS</a>
                <a href="/Categories/World">WORLD</a>
                <a href="/Categories/Sweden">SWEDEN</a>
                <a href="/Categories/Weather">WEATHER</a>
                <a href="/Categories/Sports">SPORTS</a>
                <a asp-controller="Articles" asp-action="EditorsChoice">EDITOR'S CHOICE</a>
                <a asp-controller="Articles" asp-action="Archived">ARCHIVE</a>

                <a href="/Categories/Newsletter">NEWSLETTER</a>
                @if (SignInManager.IsSignedIn(User))
                {
                    var currentUser = await UserManager.GetUserAsync(User);
                    bool isSubscribed = currentUser != null &&
                        await SubscriptionService.HasActiveSubscriptionAsync(currentUser.Email);

                    if (!isSubscribed)
                    {
                        <a asp-controller="Subscription" asp-action="Index" class="btn-subscribe-nav">
                            SUBSCRIBE
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Subscription" asp-action="MySubscription" class="btn-subscribe-nav subscribed">
                            ✓ SUBSCRIBED
                        </a>
                    }
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Register"
                       asp-route-returnUrl="/Subscription" class="btn-subscribe-nav">
                        SUBSCRIBE
                    </a>
                }

            </div>
        </nav>
    </header>


    <!-- BREAKING NEWS -->
    <section class="breaking-bar">
        <strong>BREAKING</strong>
        <span>Breaking news headline goes here</span>
    </section>


    <!-- MAIN CONTENT -->
    <main>

        <!-- FEATURED NEWS -->
        <section class="section-block">

            <div class="section-title">
                <h2>NEWS</h2>
                <a href="/Categories/News">VIEW ALL →</a>
            </div>


            @if (Model.NewsArticles.Any())
            {
                <div class="featured-grid">

                    <!-- MAIN NEWS STORY -->
                    @{
                        var mainArticle = Model.NewsArticles.First();
                    }

                    <article class="featured-story">

                        @if (!string.IsNullOrWhiteSpace(mainArticle.ImageUrl))
                        {
                            <img src="@mainArticle.ImageUrl"
                                 alt="@mainArticle.Title"
                                 class="article-image large" />
                        }
                        else
                        {
                            <div class="image-placeholder large">
                                IMAGE
                            </div>
                        }

                        <div class="story-category">
                            @mainArticle.Category
                        </div>

                        <h3>
                            <a href="/Articles/Details/@mainArticle.Id">
                                @mainArticle.Title
                            </a>
                        </h3>

                        <p>
                            @mainArticle.Summary
                        </p>

                    </article>


                    <!-- SECONDARY NEWS STORIES -->
                    <div class="side-stories">

                        @foreach (var article in Model.NewsArticles.Skip(1))
                        {
                            <article class="story">

                                @if (!string.IsNullOrWhiteSpace(article.ImageUrl))
                                {
                                    <img src="@article.ImageUrl"
                                     alt="@article.Title"
                                     class="article-image secondary"
                                     data-focal-x="@article.ImageFocalPointX"
                                     data-focal-y="@article.ImageFocalPointY" />
                                }
                                else
                                {
                                    <div class="image-placeholder">
                                        IMAGE
                                    </div>
                                }

                                <div>

                                    <div class="story-category">
                                        @article.Category
                                    </div>

                                    <h3>
                                        <a href="/Articles/Details/@article.Id">
                                            @article.Title
                                        </a>
                                    </h3>

                                    <p>
                                        @article.Summary
                                    </p>

                                </div>

                            </article>
                        }

                    </div>


                    <!-- RIGHT SIDEBAR -->
                    <aside class="sidebar">

                        <h2>EDITOR'S CHOICE</h2>

                        @if (Model.EditorsChoiceArticles.Any())
                        {
                            for (int i = 0; i < Model.EditorsChoiceArticles.Count; i++)
                            {
                                var choiceArticle = Model.EditorsChoiceArticles[i];
                                <article class="sidebar-story">
                                    <span>@((i + 1).ToString("00"))</span>
                                    <h3>
                                        <a href="/Articles/Details/@choiceArticle.Id">
                                            @choiceArticle.Title
                                        </a>
                                    </h3>
                                </article>
                            }
                        }
                        else
                        {
                            <p>No editor's choice articles yet.</p>
                        }

                    </aside>

                </div>
            }
            else
            {
                <p>No news articles available.</p>
            }

        </section>


        <!-- CATEGORY ROWS -->
        <section class="category-section">


            <!-- WORLD -->
            <div class="category-column">

                <div class="section-title">
                    <h2>
                        <a href="/Categories/World">WORLD</a>
                    </h2>

                    <a href="/Categories/World" class="section-link">MORE →</a>
                </div>


                @if (Model.WorldArticles.Any())
                {
                    var article = Model.WorldArticles.First();

                    <article class="compact-story">

                        @if (!string.IsNullOrWhiteSpace(article.ImageUrl))
                        {
                            <div class="compact-image">
                                <img src="@article.ImageUrl"
                                     alt="@article.Title"
                                     class="article-image"
                                     data-focal-x="@article.ImageFocalPointX.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                     data-focal-y="@article.ImageFocalPointY.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            </div>
                            }
                        else
                        {
                            <div class="image-placeholder">
                                IMAGE
                            </div>
                        }

                        <div>

                            <div class="story-category">
                                @article.Category
                            </div>

                            <h3>
                                <a href="/Articles/Details/@article.Id">
                                    @article.Title
                                </a>
                            </h3>

                            <p>
                                @article.Summary
                            </p>

                        </div>

                    </article>
                }
                else
                {
                    <p>No World articles available.</p>
                }

            </div>


            <!-- SWEDEN -->
            <div class="category-column">

                <div class="section-title">
                    <h2>
                        <a href="/Categories/Sweden">SWEDEN</a>
                    </h2>

                    <a href="/Categories/Sweden">MORE →</a>
                </div>


                @if (Model.SwedenArticles.Any())
                {
                    var article = Model.SwedenArticles.First();

                    <article class="compact-story">

                        @if (!string.IsNullOrWhiteSpace(article.ImageUrl))
                        {
                            <div class="compact-image">
                                <img src="@article.ImageUrl"
                                     alt="@article.Title"
                                     class="article-image"
                                     data-focal-x="@article.ImageFocalPointX.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                     data-focal-y="@article.ImageFocalPointY.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            </div>
                        }
                        else
                        {
                            <div class="image-placeholder">
                                IMAGE
                            </div>
                        }

                        <div>

                            <div class="story-category">
                                @article.Category
                            </div>

                            <h3>
                                <a href="/Articles/Details/@article.Id">
                                    @article.Title
                                </a>
                            </h3>

                            <p>
                                @article.Summary
                            </p>

                        </div>

                    </article>
                }
                else
                {
                    <p>No Sweden articles available.</p>
                }

            </div>


            <!-- SPORTS -->
            <div class="category-column">

                <div class="section-title">
                    <h2>
                        <a href="/Categories/Sports">SPORTS</a>
                    </h2>

                    <a href="/Categories/Sports">MORE →</a>
                </div>


                @if (Model.SportsArticles.Any())
                {
                    var article = Model.SportsArticles.First();

                    <article class="compact-story">

                        @if (!string.IsNullOrWhiteSpace(article.ImageUrl))
                        {
                            <div class="compact-image">
                                <img src="@article.ImageUrl"
                                     alt="@article.Title"
                                     class="article-image"
                                     data-focal-x="@article.ImageFocalPointX.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                     data-focal-y="@article.ImageFocalPointY.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            </div>
                        }
                        else
                        {
                            <div class="image-placeholder">
                                IMAGE
                            </div>
                        }

                        <div>

                            <div class="story-category">
                                @article.Category
                            </div>

                            <h3>
                                <a href="/Articles/Details/@article.Id">
                                    @article.Title
                                </a>
                            </h3>

                            <p>
                                @article.Summary
                            </p>

                        </div>

                    </article>
                }
                else
                {
                    <p>No Sports articles available.</p>
                }

            </div>

        </section>


        <!-- WEATHER -->
        <section class="weather-section">

            <div class="section-title">
                <h2>WEATHER</h2>
                <a href="/Forecast/Index" class="section-link">FULL FORECAST →</a>
            </div>

            <div class="weather-placeholder">

                <div class="weather-city" id="weatherCity"></div>

                <div id="weatherTemperature" class="weather-temp">
                    @Model.Weather?.Temp°
                </div>

                <div id="weatherCondition" class="weather-condition">
                    @Model.SmhiWeather?.SymbolDescription?.ToUpper()
                </div>

                <div id="weatherMessage" class="weather-message">
                    <div class="weather-message-title"></div>
                    <div class="weather-message-text"></div>
                </div>

                <div class="weather-info">
                    LIVE TEMPERATURE

                    <select id="weatherMunicipality"
                            class="weather-station-select">

                        @foreach (var municipality in Model.Municipalities)
                        {
                            <option value="@municipality.ApiValue"
                                    selected="@(municipality.ApiValue == Context.Session.GetString("SelectedWeatherMunicipality"))">
                                @municipality.Name
                            </option>
                        }

                    </select>
                    

                    <select id="weatherStation"
                            class="weather-station-select">

                        @foreach (var station in Model.WeatherStations)
                        {
                            <option value="@station.Id">
                                @station.Title
                            </option>
                        }

                    </select>

                </div>

                <div class="weather-attribution">
                    Weather API provided by
                    <a href="https://www.temperatur.nu/"
                       target="_blank"
                       rel="noopener noreferrer">
                        temperatur.nu
                    </a>
                </div>

            </div>

        </section>

    </main>

</div>
@section Scripts
{
    <script>

        let municipalityRequestNumber = 0;


        // Set initial municipality name

        const weatherMunicipality =
            document.getElementById("weatherMunicipality");

        const weatherCity =
            document.getElementById("weatherCity");

        if (weatherMunicipality && weatherCity)
        {
            const selectedMunicipalityName =
                weatherMunicipality.options[
                    weatherMunicipality.selectedIndex
                ].text;

            weatherCity.textContent =
                selectedMunicipalityName.toUpperCase();
        }


        // Change Temperatur.nu station
        document.getElementById("weatherStation").addEventListener("change", async function()
        {

            const stationId = this.value;

            const response =
                await fetch(`/Home/GetWeather?stationId=${stationId}`);

            if (!response.ok)
            {
                return;
            }

            const weather = await response.json();

            document.getElementById("weatherTemperature").textContent =
                weather.temp + "°";
        });


        // Change municipality
        document.getElementById("weatherMunicipality").addEventListener("change", async function()
        {

            const municipality = this.value;

            const municipalityName =
                this.options[this.selectedIndex].text;

            document.getElementById("weatherCity").textContent =
                municipalityName.toUpperCase();


            // Give this municipality selection a unique number
            const requestNumber = ++municipalityRequestNumber;


            // TEMPERATUR.NU

            const response =
                await fetch(`/Home/GetStations?municipality=${municipality}`);

            if (!response.ok)
            {
                return;
            }

            const result = await response.json();


            // Ignore an older request if the user has already
            // selected another municipality
            if (requestNumber !== municipalityRequestNumber)
            {
                return;
            }


            // Check if Temperatur.nu has temporarily blocked requests

            // if (true) // Swap "if (result.isBlocked)" for checking time limit error message
            if (result.isBlocked)
            {
                document.getElementById("weatherMessage").querySelector(".weather-message-title").textContent =
                    "LIVE TEMPERATURE TEMPORARILY UNAVAILABLE";

                document.getElementById("weatherMessage").querySelector(".weather-message-text").textContent =
                    "The external weather service has reached its request limit. Please try again later.";

                document.getElementById("weatherTemperature").textContent =
                    "";

                document.getElementById("weatherStation").innerHTML =
                    "";
            }
            else
            {
                document.getElementById("weatherMessage").querySelector(".weather-message-title").textContent = "";

                document.getElementById("weatherMessage").querySelector(".weather-message-text").textContent = "";
            }


            const stations = result.stations;

            const stationSelect =
                document.getElementById("weatherStation");

            stationSelect.innerHTML = "";


            stations.forEach(function(station)
            {
                const option =
                    document.createElement("option");

                option.value = station.id;
                option.textContent = station.title;

                stationSelect.appendChild(option);
            });


            // Select the first station and get its temperature
            if (stations.length > 0)
            {
                stationSelect.value = stations[0].id;

                const weatherResponse =
                    await fetch(
                        `/Home/GetWeather?stationId=${stations[0].id}`
                    );

                if (weatherResponse.ok)
                {
                    const weather =
                        await weatherResponse.json();

                    document.getElementById("weatherTemperature").textContent =
                        weather.temp + "°";
                }
            }


            // SMHI

            const smhiResponse =
                await fetch(
                    `/Home/GetSmhiWeather?municipality=${municipality}`
                );

            if (!smhiResponse.ok)
            {
                return;
            }

            const smhiWeather =
                await smhiResponse.json();


            // Ignore an older municipality request
            if (requestNumber !== municipalityRequestNumber)
            {
                return;
            }

            document.getElementById("weatherCondition").textContent =
                smhiWeather.symbolDescription.toUpperCase();

        });
        function applyFocalPoints() {

        const images =
            document.querySelectorAll(".article-image[data-focal-x]");

        images.forEach(function (image) {

            const focalX =
                parseFloat(image.dataset.focalX);

            const focalY =
                parseFloat(image.dataset.focalY);

            if (isNaN(focalX) || isNaN(focalY)) {
                return;
            }

            if (!image.complete) {
                image.addEventListener("load", function () {
                    calculateObjectPosition(image, focalX, focalY);
                }, { once: true });

                return;
            }

            calculateObjectPosition(image, focalX, focalY);
        });
    }


    function applyFocalPoints() {

    const images =
        document.querySelectorAll(".article-image[data-focal-x]");

    images.forEach(function (image) {

        const focalX =
            parseFloat(image.dataset.focalX);

        const focalY =
            parseFloat(image.dataset.focalY);

        if (isNaN(focalX) || isNaN(focalY)) {
            return;
        }

        if (!image.complete) {
            image.addEventListener("load", function () {
                calculateObjectPosition(image, focalX, focalY);
            }, { once: true });

            return;
        }

        calculateObjectPosition(image, focalX, focalY);
    });
}


function calculateObjectPosition(image, focalX, focalY) {

    const imageWidth = image.naturalWidth;
    const imageHeight = image.naturalHeight;

    const containerWidth = image.clientWidth;
    const containerHeight = image.clientHeight;

    if (!imageWidth || !imageHeight ||
        !containerWidth || !containerHeight) {
        return;
    }

    const imageRatio =
        imageWidth / imageHeight;

    const containerRatio =
        containerWidth / containerHeight;


    // How much of the original image is visible
    // in the crop area.

    const visibleWidth =
        Math.min(1, containerRatio / imageRatio);

    const visibleHeight =
        Math.min(1, imageRatio / containerRatio);


    // Calculate the object-position needed to put
    // the selected focal point as close as possible
    // to the centre of the crop.

    let positionX =
        ((focalX / 100) - (visibleWidth / 2)) /
        (1 - visibleWidth);

    let positionY =
        ((focalY / 100) - (visibleHeight / 2)) /
        (1 - visibleHeight);


    // If the whole dimension is visible, position
    // does not matter in that direction.

    if (visibleWidth >= 1) {
        positionX = 0.5;
    }

    if (visibleHeight >= 1) {
        positionY = 0.5;
    }


    // Keep the values between 0 and 1.

    positionX =
        Math.max(0, Math.min(1, positionX));

    positionY =
        Math.max(0, Math.min(1, positionY));


    image.style.objectPosition =
        `${positionX * 100}% ${positionY * 100}%`;
}


window.addEventListener("load", applyFocalPoints);

window.addEventListener("resize", applyFocalPoints);

function applyCompactImageFocalPoints() {

    const images =
        document.querySelectorAll(".compact-image .article-image[data-focal-x]");

    const secondaryImage =
        document.querySelector(".story .article-image.secondary");

    let secondaryWidth = 366;
    let secondaryHeight = 100;

    if (secondaryImage) {
        secondaryWidth = secondaryImage.clientWidth;
        secondaryHeight = secondaryImage.clientHeight;
    }

    images.forEach(function (image) {

        const focalX = parseFloat(image.dataset.focalX);
        const focalY = parseFloat(image.dataset.focalY);

        if (isNaN(focalX) || isNaN(focalY)) {
            return;
        }

        if (!image.complete) {
            image.addEventListener("load", function () {
                positionCompactImage(
                    image,
                    focalX,
                    focalY,
                    secondaryWidth,
                    secondaryHeight
                );
            }, { once: true });

            return;
        }

        positionCompactImage(
            image,
            focalX,
            focalY,
            secondaryWidth,
            secondaryHeight
        );
    });
}


function positionCompactImage(
    image,
    focalX,
    focalY,
    secondaryWidth,
    secondaryHeight
) {

    const container = image.parentElement;

    const naturalWidth = image.naturalWidth;
    const naturalHeight = image.naturalHeight;

    const containerWidth = container.clientWidth;
    const containerHeight = container.clientHeight;

    if (!naturalWidth || !naturalHeight ||
        !containerWidth || !containerHeight) {
        return;
    }

    /*
     * Calculate the scale used by the secondary image
     * with object-fit: cover.
     */
    const secondaryScale = Math.max(
        secondaryWidth / naturalWidth,
        secondaryHeight / naturalHeight
    );

    /*
     * Category image is approximately 20% less zoomed.
     */
    let categoryScale = secondaryScale * 0.7;

    /*
     * Make sure the image still completely covers
     * the 130 x 110 category window.
     */
    const minimumScale = Math.max(
        containerWidth / naturalWidth,
        containerHeight / naturalHeight
    );

    categoryScale = Math.max(
        categoryScale,
        minimumScale
    );

    const imageWidth = naturalWidth * categoryScale;
    const imageHeight = naturalHeight * categoryScale;

    image.style.width = imageWidth + "px";
    image.style.height = imageHeight + "px";

    /*
     * Position the focal point in the centre of
     * the category window.
     */
    let left =
        (containerWidth / 2) -
        (imageWidth * focalX / 100);

    let top =
        (containerHeight / 2) -
        (imageHeight * focalY / 100);

    /*
     * Prevent empty space around the image.
     */
    const minLeft = containerWidth - imageWidth;
    const minTop = containerHeight - imageHeight;

    left = Math.max(minLeft, Math.min(0, left));
    top = Math.max(minTop, Math.min(0, top));

    image.style.position = "absolute";
    image.style.left = left + "px";
    image.style.top = top + "px";
}


window.addEventListener("load", applyCompactImageFocalPoints);
window.addEventListener("resize", applyCompactImageFocalPoints);






    </script>
}



