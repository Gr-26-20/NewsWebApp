@{
}

@model NewsLetter

<h1>Edit</h1>

<h4>Newsletter</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="EditNewsletter" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
             <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Category" class="control-label"></label>

                <select asp-for="Category" class="form-control">
                    <option value="">-- Select Category --</option>
                    <option value="News">News</option>
                    <option value="World">World</option>
                    <option value="Sweden">Sweden</option>
                    <option value="Weather">Weather</option>
                    <option value="Sports">Sports</option>
                </select>

                <span asp-validation-for="Category" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Subject" class="control-label"></label>
                <input asp-for="Subject" class="form-control" />
                <span asp-validation-for="Subject" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Logo" class="control-label"></label> <br />
				<img id="logoPreview" src="@Model.Logo" alt="Logo" class="thumbnail" /> 
                <input asp-for="Logo" type="file" class="form-control" accept="image/*" onchange="previewImage(this, 'logoPreview')" />
                <span asp-validation-for="Logo" class="text-danger"></span>
            </div>

             <div class="form-group">
                <label asp-for="Body" class="control-label"></label>
                <input type="hidden" asp-for="Body" class="form-control" rows="5"/>
                <span asp-validation-for="Body" class="text-danger"></span>
            </div> 

            <div class="form-group">
                <label asp-for="imageUrl" class="control-label"></label> <br />
				<img id="imageUrlPreview" src="@Model.imageUrl" alt="Image" class="thumbnail" /> 
                <input asp-for="imageUrl" type="file" class="form-control" accept="image/*" onclick="previewImage(this, 'imageUrlPreview')" />
                <span asp-validation-for="imageUrl" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

             <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div> 

             <div class="form-group">
                <label asp-for="link" class="control-label"></label>
                <input asp-for="link" class="form-control" />
                <span asp-validation-for="link" class="text-danger"></span>
            </div> 

             <div class="form-group">
                <label asp-for="imageUrl2" class="control-label"></label> <br />
				<img id="imageUrl2Preview" src="@Model.imageUrl2" alt="Image2" class="thumbnail"/>
                <input asp-for="imageUrl2" type="file" class="form-control" accept="image/*" onclick="previewImage(this, 'imageUrl2Preview')" />
                <span asp-validation-for="imageUrl2" class="text-danger"></span>
            </div> 

             <div class="form-group">
                <label asp-for="Title2" class="control-label"></label>
                <input asp-for="Title2" class="form-control" />
                <span asp-validation-for="Title2" class="text-danger"></span>
            </div> 

            <div class="form-group">
                <label asp-for="Description2" class="control-label"></label>
                <textarea asp-for="Description2" class="form-control" rows="5"></textarea>  
                <span asp-validation-for="Description2" class="text-danger"></span>
            </div>

             <div class="form-group">
                <label asp-for="link2" class="control-label"></label>
                <input asp-for="link2" class="form-control" />
                <span asp-validation-for="link2" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="imageUrl3" class="control-label"></label> <br />
				<img id="imageUrl3Preview" src="@Model.imageUrl3" alt="Image3" class="thumbnail"/>
                <input asp-for="imageUrl3" type="file" class="form-control" accept="image/*" onclick="previewImage(this, 'imageUrl3Preview')" />    
                <span asp-validation-for="imageUrl3" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Title3" class="control-label"></label>
                <input asp-for="Title3" class="form-control" />
                <span asp-validation-for="Title3" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description3" class="control-label"></label>
                <textarea asp-for="Description3" class="form-control" rows="5"></textarea>  
                <span asp-validation-for="Description3" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="link3" class="control-label"></label>
                <input asp-for="link3" class="form-control"/>  
                <span asp-validation-for="link3" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="ManageNewsletters" asp-controller="Newsletter">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");

    }
}
<script src="~/js/ImagePreview.js"></script>

