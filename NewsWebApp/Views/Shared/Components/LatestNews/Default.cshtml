@{
}

@* @model IEnumerable<NewsWebApp.Models.Feedback> *@
@model IEnumerable<NewsWebApp.Models.Feedback> 

 


@if (Model != null)
{
	@* @await Component.InvokeAsync("LatestNews")   *@
	@foreach (var item in Model)
	{

		<div class="card">
			<div class="card-header">
				<p><strong>Created At:</strong> @item.CreatedAt.ToString()</p>
				<p><strong>Updated at: </strong>@item.UpdatedAt</p>
			</div>
			<div class="card-body">
				<p>@item.Feedbackstring</p>
			</div>
			<div class="card-footer">
				<a class="btn btn-primary" asp-action="Edit" asp-controller="Editor" asp-route-id="@item.Id">Edit</a>
				<a class="btn btn-danger" asp-action="Delete" asp-controller="Editor" asp-route-id="@item.Id">Deleteetetetete</a>
				<button type="button" class="btn btn-outline-danger" onclick="UpdateFeedback(@item.Id)">Remove</button> 
			</div>
		</div>
	}

}

