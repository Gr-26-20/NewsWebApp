<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NewsWebApp</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NewsWebApp.styles.css" asp-append-version="true" />
</head>
<body>
     <header>
        <div class="container">
            <partial name="_CookieConsentPartial" />
        </div>
        <nav class="navbar navbar-expand-xl navbar-light shared-news-nav" aria-label="Main navigation">
            <div class="container news-container">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sharedNavigation" aria-controls="sharedNavigation"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="sharedNavigation" class="navbar-collapse collapse">
                    <div class="shared-nav-links">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Analytics" asp-action="Index">Analytics</a>
                        </li>
                    }
                    </ul>
                    <partial name="_LoginPartial" />
                    </div>
                    <form class="shared-nav-search" asp-controller="Writer" asp-action="Search" method="get" role="search">
                        <label class="visually-hidden" for="navArticleSearch">Search articles</label>
                        <input id="navArticleSearch" type="search" name="SearchString" placeholder="Search articles…" />
                        <button type="submit">Search</button>
                    </form>
                </div>
            </div>
        </nav>
    </header> 

    <div class="login-strip">
        <div class="login-inner">
            <span>DAILY NEWS</span>
            @* <partial name="_LoginPartial" /> *@
        </div>
    </div>

    <div class="container news-container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container">
            © 2026 CLICKBAIT News
            &nbsp; | &nbsp;
            <a asp-controller="Contact" asp-action="Index">Contact Us</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
            function toggleNavigation() {
                document.getElementById("navCategories").classList.toggle("open");
                document.getElementById("navAccount").classList.toggle("open");
            }
    </script>
    <script src="/_framework/aspnetcore-browser-refresh.js"></script>
</body>
</html>
