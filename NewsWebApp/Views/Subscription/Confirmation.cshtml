@{
    var active = ViewBag.SubscriptionActive == true;
    ViewData["Title"] = active ? "Subscription Confirmed" : "Checking Payment";
}
<div class="sub-page">
    <div class="sub-card">
        <span class="sub-badge">@(active ? "CONFIRMED" : "PROCESSING")</span>
        <h1 class="sub-title">@(active ? "You're in!" : "We're checking your payment")</h1>
        <p class="sub-subtitle">
            @(active ? "Your premium access is active. Thank you for supporting CLICKBAIT News."
                : "Access will appear once Stripe confirms payment. Check your subscription again shortly.")
        </p>
        <a asp-action="MySubscription" class="btn-sub">View my subscription →</a>
        <a asp-controller="Home" asp-action="Index" class="sub-back">Back to news</a>
    </div>
</div>
