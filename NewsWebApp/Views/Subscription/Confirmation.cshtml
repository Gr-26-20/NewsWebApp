@{
    ViewData["Title"] = "Subscription Confirmed";
}

<div class="sub-page">
    <div class="sub-card">
        <div class="sub-badge active">CONFIRMED</div>

        <div class="sub-icon">✅</div>

        <h2 class="sub-title">You're In!</h2>
        <p class="sub-subtitle">Welcome to CLICKBAIT News Premium.</p>

        <div class="mysub-details">
            <div class="mysub-detail-row">
                <span class="mysub-detail-label">Status</span>
                <span class="mysub-detail-value mysub-days-left">Active</span>
            </div>
            <div class="mysub-detail-row">
                <span class="mysub-detail-label">Duration</span>
                <span class="mysub-detail-value">30 days</span>
            </div>
        </div>

        <div class="mysub-perks" style="margin-bottom: 1.5rem;">
            <span>✓ Unlimited premium articles unlocked</span>
            <span>✓ Ad-free reading experience</span>
            <span>✓ Breaking news before everyone else</span>
        </div>

        <a asp-controller="Home" asp-action="Index" class="btn-sub">Start Reading →</a>

        <p class="sub-note">A confirmation email has been sent to you.</p>
    </div>
</div>