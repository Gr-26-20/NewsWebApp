@using NewsWebApp.Models.ViewModels
@model SubscribeViewModel

<div class="sub-page">
    <div class="sub-card">
        <div class="sub-badge">PREMIUM</div>
        <h1 class="sub-title">CLICKBAIT News</h1>
        <p class="sub-subtitle">The stories you can't ignore — now without limits.</p>

        <ul class="subscribe-perks">
            <li>✓ Unlimited access to all premium articles</li>
            <li>✓ Ad-free reading experience</li>
            <li>✓ Breaking news before everyone else</li>
            <li>✓ Cancel anytime</li>
        </ul>

        <div class="subscribe-price">
            <span class="price-amount">99.99</span>
            <span class="price-currency">SEK</span>
            <span class="price-period">/ 30 days</span>
        </div>

        <a asp-action="Pay" class="btn-sub">Get Full Access →</a>

        <p class="sub-note">Secure payment powered by Stripe. No hidden fees.</p>
    </div>
</div>