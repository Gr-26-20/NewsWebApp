@using NewsWebApp.Models.ViewModels

@{
    ViewData["Title"] = "Subscribe";
}


<partial name="_NavbarPartial" />


<div class="sub-page">
    <div class="sub-card">
        <div class="sub-badge">PREMIUM</div>
        <h1 class="sub-title">CLICKBAIT News</h1>
        <p class="sub-subtitle">The stories you can't ignore — now without limits.</p>

        <ul class="subscribe-perks">
            <li>✓ Unlimited access to all premium articles</li>
            <li>✓ Ad-free reading experience</li>
            <li>✓ Breaking news before everyone else</li>
            <li>✓ Cancel anytime</li>
        </ul>

        <div class="subscribe-price">
            <span class="price-amount">99.99</span>
            <span class="price-currency">SEK</span>
            <span class="price-period">/ month</span>
        </div>

        @if (TempData["BillingError"] is string error)
        { <p class="pay-error" role="alert">@error</p> }
        @if (Context.Request.Query["cancelled"] == "true")
        { <p role="status">Checkout was cancelled. No subscription was activated.</p> }

        <form asp-action="CreateCheckoutSession" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-sub">Subscribe with Stripe →</button>
        </form>

        <p class="sub-note">Test mode. Renews monthly until cancelled. Manage your subscription through your billing account.</p>
    </div>
</div>
