@model NewsWebApp.Models.Subscriptions?
@{
    ViewData["Title"] = "My Subscription";
    var expires = Model?.CurrentPeriodEndUtc ?? Model?.CreatedAt?.AddDays(Model.DurationInDays);
    var daysLeft = expires.HasValue ? Math.Max(0, (int)Math.Ceiling((expires.Value - DateTime.UtcNow).TotalDays)) : 0;
}

<partial name="_NavbarPartial" />

<div class="account-page">
    <partial name="/Views/Shared/_AccountHeader.cshtml" />
    <div class="account-grid">
        <aside><partial name="/Views/Shared/_AccountNav.cshtml" /></aside>
        <section class="account-panel">
            <p class="account-kicker">YOUR READING, UPGRADED</p>
            <h1>My subscription</h1>
            
            @if (TempData["BillingError"] is string error)
            { 
                <div class="account-notice account-notice-error" role="alert">@error</div> 
            }
            @if (Model is null)
            {
                <span class="account-badge">NO ACTIVE PREMIUM PLAN</span>
               
                <p class="account-intro">Explore premium</p>
                <a asp-action="Index" class="account-button">Explore premium →</a>
            }
            else
            {
                <div class="account-plan-heading">
                    <span class="account-badge">@(Model.CancelAtPeriodEnd ? "CANCELLATION SCHEDULED" : "PREMIUM ACTIVE")</span>
                    <h2>@Model.Name</h2>
                    <p class="account-plan-price">@Model.Price.ToString("N2") <span>SEK / @(Model.StripeStatus is null ? "30 days" : "month")</span></p>
                </div>
                <dl class="account-plan-details">
                    <div><dt>Started</dt><dd>@Model.CreatedAt?.ToString("dd MMM yyyy")</dd></div>
                    <div><dt>@(Model.CancelAtPeriodEnd || Model.StripeStatus is null ? "Access until" : "Renews on")</dt><dd>@expires?.ToString("dd MMM yyyy")</dd></div>
                    <div><dt>Days remaining in this period</dt><dd>@daysLeft</dd></div>
                </dl>
                @if (Model.CancelAtPeriodEnd)
                {
                    <p class="account-notice">Your subscription is set to end. You can keep reading premium articles until @expires?.ToString("dd MMM yyyy").</p>
                }
                <p class="account-intro">Thank you for supporting CLICKBAIT News</p>
            }
            @if (ViewBag.HasStripeCustomer == true)
            {
                <div class="account-secondary-action">
                    <h2>You're in control.</h2>
                    <p class="account-intro">Update your payment method or cancel through Stripe.</p>
                    <form asp-action="ManageBilling" method="post">
                        <button type="submit" class="account-button">Manage billing / cancel →</button>
                    </form>
                </div>
            }
            <a class="account-back-link" asp-area="" asp-page="/Profile">← Back to my profile</a>
        </section>
    </div>
</div>
