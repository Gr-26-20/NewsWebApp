@{
	
}
@using NewsWebApp.Models.ViewModels
@model NewsWebApp.Models.ViewModels.ArticlesVM
@* @if (Model.Articles == null || !Model.Articles.Any())
{
	<h4>No articles found.</h4>
} *@
<div>
	<form asp-action="SortArticles" method="post" asp-controller="Writer">
		<Select asp-for="status" class="form-control" asp-items="Model.Statuses">
			<option value="">Please select an option</option>
		</Select>
		<button class="btn btn-dark" type="submit">Sort</button>
	</form>
</div>

@foreach (var article in Model.Articles!)
{
	<div class="card">
		<div class="card-header">
			<p><strong>Created At:</strong> @article.CreatedAt.ToString()</p>
			<p><strong>Article status: </strong>@article.articleStatus</p>
		</div>
		<div class="card-body">
			<img src="@article.ImageUrl" alt="@article.Title" class="img-fluid" style="max-width: 50%; max-height: 50%; float: right; display: flex; align-items: center; justify-content:center;">
			<p><strong>Author:</strong> @article.Author</p>
			<p><strong>Slug:</strong> @article.Slug</p>
			<p><strong>Category:</strong> @article.Category</p>
			<p><strong>Views:</strong> @article.Views</p>
			<p><strong>Likes:</strong> @article.Likes</p>
		</div>
		<div class="card-footer">
			<a class="btn btn-primary" asp-action="EditArticle" asp-controller="Writer" asp-route-id="@article.Id">Edit</a>
			<a class="btn btn-danger" asp-action="DeleteArticle" asp-controller="Writer" asp-route-id="@article.Id">Delete</a>
			<a class="btn btn-warning" asp-action="Create" asp-controller="Editor" asp-route-id="@article.Id">Add feedback</a>
			<a class="btn btn-info" asp-action="Details" asp-controller="Editor" asp-route-id="@article.Id">View feedback</a>
			<a class="btn btn-warning" asp-action="GetAllFeedback" asp-controller="Editor">view all feedback</a>
		</div>
		@if (User.IsInRole("Editor") || User.IsInRole("Admin"))
		{
			<div class="card-footer">
				<a class="btn btn-success" asp-action="Approve" asp-controller="Editor" asp-route-id="@article.Id">Approve</a>
				<a class="btn btn-danger" asp-action="Reject" asp-controller="Editor" asp-route-id="@article.Id">Reject</a>
				<a class="btn btn-warning" asp-action="Archive" asp-controller="Editor" asp-route-id="@article.Id">Archive</a>
			</div>
		}
	</div>
}  