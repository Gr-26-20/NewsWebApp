@model NewsWebApp.Models.Articles

@{
	ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Articles</h4>
<hr />
<div class="row">
	<div class="col-md-4">
		<form asp-action="Create" method="post" enctype="multipart/form-data">
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>

			<input asp-for="ImageFocalPointX" type="hidden" />
			<input asp-for="ImageFocalPointY" type="hidden" />

			<div class="form-group">
				<label asp-for="Slug" class="control-label"></label>
				<input asp-for="Slug" class="form-control" />
				<span asp-validation-for="Slug" class="text-danger"></span>
			</div>

			<div class="form-group">
				<label asp-for="Title" class="control-label"></label>
				<input asp-for="Title" class="form-control" />
				<span asp-validation-for="Title" class="text-danger"></span>
			</div>

			<div class="form-group">
				<label asp-for="Author" class="control-label"></label>
				<input asp-for="Author" class="form-control" />
				<span asp-validation-for="Author" class="text-danger"></span>
			</div>

			<div class="form-group">
				<label asp-for="Summary" class="control-label"></label>
				<textarea asp-for="Summary" class="form-control" rows="5" placeholder="Enter article summary"></textarea>
				<span asp-validation-for="Summary" class="text-danger"></span>
			</div>

			<div class="form-group">
				<label asp-for="Content" class="control-label"></label>
				<textarea asp-for="Content"
						  class="form-control"
						  rows="12"
						  placeholder="Enter the complete article"></textarea>
				<span asp-validation-for="Content" class="text-danger"></span>
			</div>

			<div class="form-group">
				<label for="ImageFile" class="control-label">Image</label>
				<input type="file" name="ImageFile" id="ImageFile" class="form-control" accept="image/*" />
			</div>

			<div class="form-group">
				<label asp-for="Category" class="control-label"></label>

				<select asp-for="Category" class="form-control">
					<option value="">-- Select Category --</option>
					<option value="News">News</option>
					<option value="World">World</option>
					<option value="Sweden">Sweden</option>
					<option value="Weather">Weather</option>
					<option value="Sports">Sports</option>
				</select>

				<span asp-validation-for="Category" class="text-danger"></span>
			</div>

			<div class="form-group form-check">
				<input asp-for="EditorChoice" class="form-check-input" />
				<label asp-for="EditorChoice" class="form-check-label"></label>
				<span asp-validation-for="EditorChoice" class="text-danger"></span>
			</div>

			<div class="form-group">
				<input type="submit" value="Create" class="btn btn-primary" />
			</div>

		</form>
	</div>

	<div class="col-md-6">

		<!-- IMAGE PREVIEW HEADER -->

		<div class="image-preview-header">

			<div>
				<h4>Image Preview</h4>

				<p id="previewMessage">
					Select an image to set the focal point.
				</p>
			</div>

			<div id="focalPointValues">
				Focal X: <span id="focalXDisplay">50</span>%<br />
				Focal Y: <span id="focalYDisplay">50</span>%
			</div>

		</div>


		<!-- MAIN NEWS -->

		<div class="image-preview-section">

			<h5>Main News</h5>

			<div id="mainPreviewContainer"
				 class="crop-preview main-preview">

				<img id="mainImagePreview"
					 src=""
					 alt="Main news preview" />

				<div id="mainFocalPointMarker"></div>

			</div>

			<p class="preview-help">
				Click the image to set the focal point.
			</p>
			<label for="mainZoom">Zoom: <span id="mainZoomDisplay">100%</span></label>
			<input type="range"
				   id="mainZoom"
				   class="zoom-control"
				   min="100"
				   max="300"
				   value="100"
				   step="1" />

			<div id="mainPositionControls">

				<label for="mainPositionX">
					Position X: <span id="mainPositionXDisplay">50%</span>
				</label>

				<input type="range"
					   id="mainPositionX"
					   class="zoom-control"
					   min="0"
					   max="100"
					   value="50"
					   step="1" />

				<label for="mainPositionY">
					Position Y: <span id="mainPositionYDisplay">50%</span>
				</label>

				<input type="range"
					   id="mainPositionY"
					   class="zoom-control"
					   min="0"
					   max="100"
					   value="50"
					   step="1" />

			</div>

		</div>


		<!-- SECONDARY + CATEGORY -->

		<div class="small-preview-row">

			<div class="image-preview-section">

				<h5>Secondary</h5>

				<div id="secondaryPreviewContainer"
					 class="crop-preview secondary-preview">

					<img id="secondaryImagePreview"
						 src=""
						 alt="Secondary news preview" />

				</div>
				<label for="secondaryZoom">Zoom: <span id="secondaryZoomDisplay">100%</span></label>
				<input type="range"
					   id="secondaryZoom"
					   class="zoom-control"
					   min="100"
					   max="300"
					   value="100"
					   step="1" />
			</div>


			<div class="image-preview-section">

				<h5>Category</h5>

				<div id="categoryPreviewContainer"
					 class="crop-preview category-preview">

					<img id="categoryImagePreview"
						 src=""
						 alt="Category preview" />

				</div>
				<label for="categoryZoom">Zoom: <span id="categoryZoomDisplay">100%</span></label>
				<input type="range"
					   id="categoryZoom"
					   class="zoom-control"
					   min="100"
					   max="300"
					   value="100"
					   step="1" />

			</div>

		</div>

	</div>
</div>


<div>
	<a asp-action="Articles" asp-controller="Writer">Back to List</a>
</div>


@section Scripts {

	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}

	<script>

		const imageFile =
			document.getElementById("ImageFile");

		const previewMessage =
			document.getElementById("previewMessage");

		const mainImagePreview =
			document.getElementById("mainImagePreview");

		const mainFocalPointMarker =
			document.getElementById("mainFocalPointMarker");

		const secondaryImagePreview =
			document.getElementById("secondaryImagePreview");

		const categoryImagePreview =
			document.getElementById("categoryImagePreview");

		const focalPointX =
			document.getElementById("ImageFocalPointX");

		const focalPointY =
			document.getElementById("ImageFocalPointY");

		const focalXDisplay =
			document.getElementById("focalXDisplay");

		const focalYDisplay =
			document.getElementById("focalYDisplay");


		const previews = [
			{
				image: mainImagePreview,
				width: 622,
				height: 310
			},
			{
				image: secondaryImagePreview,
				width: 366,
				height: 100
			},
			{
				image: categoryImagePreview,
				width: 130,
				height: 110
			}
		];


		/*
		 * IMAGE SELECTION
		 */

		imageFile.addEventListener("change", async function () {

			const file = this.files[0];

			if (!file) {

				previews.forEach(function (preview) {

					preview.image.style.display = "none";

				});

				previewMessage.style.display = "block";

				return;
			}


			try {

				const bitmap =
					await createImageBitmap(file, {
						imageOrientation: "from-image"
					});


				const naturalWidth =
					bitmap.width;

				const naturalHeight =
					bitmap.height;


				bitmap.close();


				const imageUrl =
					URL.createObjectURL(file);


				previews.forEach(function (preview) {

					const image =
						preview.image;

					const containerWidth =
						preview.width;

					const containerHeight =
						preview.height;


					/*
					 * Scale the image so that it
					 * completely covers the preview.
					 */

					const scale =
						Math.max(
							containerWidth / naturalWidth,
							containerHeight / naturalHeight
						);


					const displayWidth =
						naturalWidth * scale;

					const displayHeight =
						naturalHeight * scale;


					image.style.width =
						displayWidth + "px";

					image.style.height =
						displayHeight + "px";


					image.style.left =
						((containerWidth - displayWidth) / 2) + "px";

					image.style.top =
						((containerHeight - displayHeight) / 2) + "px";


					image.src =
						imageUrl;

					image.style.display =
						"block";

				});


				previewMessage.style.display =
					"none";


				/*
				 * Start the focal point at the
				 * current saved value, or 50 / 50.
				 */

				const x =
					parseFloat(
						focalPointX.value.replace(",", ".")
					) || 50;

				const y =
					parseFloat(
						focalPointY.value.replace(",", ".")
					) || 50;


				focalXDisplay.textContent =
					x.toFixed(2);

				focalYDisplay.textContent =
					y.toFixed(2);

						mainFocalPointMarker.style.left =
				x + "%";

				mainFocalPointMarker.style.top =
					y + "%";

				mainFocalPointMarker.style.display =
					"block";

				/*
				 * Apply the focal point to the
				 * secondary and category previews.
				 */

				updateSmallPreviews(x, y);

			}
			catch (error) {

				console.error(
					"Could not read image:",
					error
				);

			}

		});


		/*
		 * SECONDARY + CATEGORY FOCAL POINT
		 */

		function updateSmallPreviews(x, y) {

			applyFocalPoint(
				secondaryImagePreview,
				366,
				100,
				x,
				y
			);


			applyFocalPoint(
				categoryImagePreview,
				130,
				110,
				x,
				y
			);

		}


		function applyFocalPoint(
			image,
			containerWidth,
			containerHeight,
			x,
			y
		) {

			const imageWidth =
				image.offsetWidth;

			const imageHeight =
				image.offsetHeight;


			let left =
				containerWidth / 2 -
				imageWidth * x / 100;


			let top =
				containerHeight / 2 -
				imageHeight * y / 100;


			const minLeft =
				containerWidth - imageWidth;

			const minTop =
				containerHeight - imageHeight;


			left =
				Math.max(
					minLeft,
					Math.min(0, left)
				);


			top =
				Math.max(
					minTop,
					Math.min(0, top)
				);


			image.style.left =
				left + "px";

			image.style.top =
				top + "px";

		}

				mainImagePreview.addEventListener(
			"click",
			setFocalPoint
		);


		
		


				function setFocalPoint(event) {

			const container =
				document.getElementById("mainPreviewContainer");

			const rect =
				container.getBoundingClientRect();

			let x =
				((event.clientX - rect.left) /
					rect.width) * 100;

			let y =
				((event.clientY - rect.top) /
					rect.height) * 100;

			x =
				Math.max(
					0,
					Math.min(100, x)
				);

			y =
				Math.max(
					0,
					Math.min(100, y)
				);


			focalPointX.value =
				x.toFixed(2).replace(".", ",");

			focalPointY.value =
				y.toFixed(2).replace(".", ",");


			focalXDisplay.textContent =
				x.toFixed(2);

			focalYDisplay.textContent =
				y.toFixed(2);


			mainFocalPointMarker.style.left =
				x + "%";

			mainFocalPointMarker.style.top =
				y + "%";

			mainFocalPointMarker.style.display =
				"block";


			updateSmallPreviews(x, y);

		}


		 /* MAIN NEWS DRAGGING
		 */

		let dragging =
			false;

		let dragStartX =
			0;

		let dragStartY =
			0;

		let imageStartLeft =
			0;

		let imageStartTop =
			0;


		const mainPreviewContainer =
			document.getElementById(
				"mainPreviewContainer"
			);


		mainPreviewContainer.addEventListener(
			"pointerdown",
			function (event) {

				if (
					event.target !==
					mainImagePreview
				) {
					return;
				}


				return;


				mainPreviewContainer.setPointerCapture(
					event.pointerId
				);


				dragStartX =
					event.clientX;

				dragStartY =
					event.clientY;


				imageStartLeft =
					parseFloat(
						mainImagePreview.style.left
					) || 0;


				imageStartTop =
					parseFloat(
						mainImagePreview.style.top
					) || 0;


				mainImagePreview.style.cursor =
					"grabbing";

			}
		);


		mainPreviewContainer.addEventListener(
			"pointermove",
			function (event) {

				if (!dragging) {
					return;
				}


				const dx =
					event.clientX -
					dragStartX;


				const dy =
					event.clientY -
					dragStartY;


				const imageWidth =
					mainImagePreview.offsetWidth;


				const imageHeight =
					mainImagePreview.offsetHeight;


				const minLeft =
					622 -
					imageWidth;


				const minTop =
					310 -
					imageHeight;


				let newLeft =
					imageStartLeft + dx;


				let newTop =
					imageStartTop + dy;


				/*
				 * Only allow movement where the
				 * image extends beyond the crop.
				 */

				newLeft =
					Math.max(
						minLeft,
						Math.min(0, newLeft)
					);


				newTop =
					Math.max(
						minTop,
						Math.min(0, newTop)
					);


				mainImagePreview.style.left =
					newLeft + "px";


				mainImagePreview.style.top =
					newTop + "px";

			}
		);


		mainPreviewContainer.addEventListener(
			"pointerup",
			function () {

				dragging =
					false;

				mainImagePreview.style.cursor =
					"grab";

			}
		);


		mainPreviewContainer.addEventListener(
			"pointercancel",
			function () {

				dragging =
					false;

				mainImagePreview.style.cursor =
					"grab";

			}
		);

	</script>
}