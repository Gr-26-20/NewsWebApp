@model NewsWebApp.Models.Articles

@{
    ViewData["Title"] = "Edit";
}
<div class="writer-edit-page">
<h1>Edit</h1>



<form asp-action="EditArticle" method="post" enctype="multipart/form-data">

    <div asp-validation-summary="All" class="text-danger"></div>

    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ImageUrl" />

    <input asp-for="ImageFocalPointX" type="hidden" />
    <input asp-for="ImageFocalPointY" type="hidden" />

    <input type="hidden" asp-for="SecondaryImageZoom" id="secondaryImageZoomValue" />
    <input type="hidden" asp-for="CategoryImageZoom" id="categoryImageZoomValue" />
    <input type="hidden" asp-for="MainImageZoom" id="mainImageZoomValue" />
    <input type="hidden" asp-for="MainImagePositionX" id="mainImagePositionXValue" />
    <input type="hidden" asp-for="MainImagePositionY" id="mainImagePositionYValue" />

    <div class="row g-4">
        <!-- HEADINGS: DESKTOP ONLY -->
        <div class="col-12 d-none d-lg-block">

            <div class="row g-4 edit-article-column-headings">

                <div class="col-lg-6">
                    <h4>Articles</h4>
                </div>

                <div class="col-lg-5">
                    <h4>Image Preview</h4>
                </div>

            </div>

            <hr class="edit-article-divider" />

        </div>

        <!-- LEFT COLUMN: Article fields -->
        <div class="col-12 col-lg-6 article-fields-column">
            <h4 class="d-lg-none mobile-column-heading">Articles</h4>

            <div class="form-group mb-3">
                <label asp-for="Slug" class="control-label"></label>
                <input asp-for="Slug" class="form-control" />
                <span asp-validation-for="Slug" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Author" class="control-label"></label>
                <input asp-for="Author" class="form-control" />
                <span asp-validation-for="Author" class="text-danger"></span>
            </div>
            

            <div class="form-group mb-3">
                <label asp-for="Summary" class="control-label"></label>
                <textarea asp-for="Summary"
                          class="form-control"
                          rows="5"
                          placeholder="Enter article summary"></textarea>
                <span asp-validation-for="Summary" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Content" class="control-label"></label>
                <textarea asp-for="Content"
                          class="form-control"
                          rows="12"
                          placeholder="Enter the complete article"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label for="ImageFile" class="control-label mb-2">Replace Image</label>
                <input type="file"
                       name="ImageFile"
                       id="ImageFile"
                       class="form-control"
                       accept="image/*" />
            </div>
            <div class="form-group mb-3">
                <label asp-for="Category" class="control-label"></label>

                <select asp-for="Category" class="form-control">
                    <option value="">-- Select Category --</option>
                    <option value="News">News</option>
                    <option value="World">World</option>
                    <option value="Sweden">Sweden</option>
                    <option value="Weather">Weather</option>
                    <option value="Sports">Sports</option>
                </select>

                <span asp-validation-for="Category" class="text-danger"></span>
            </div>

            @* Views is managed by the application.
            <div class="form-group">
                <label asp-for="Views" class="control-label"></label>
                <input asp-for="Views" class="form-control" />
                <span asp-validation-for="Views" class="text-danger"></span>
            </div>
            *@

            @* Likes is managed by the application.
            <div class="form-group">
                <label asp-for="Likes" class="control-label"></label>
                <input asp-for="Likes" class="form-control" />
                <span asp-validation-for="Likes" class="text-danger"></span>
            </div>
            *@

            @* CreatedAt is set when the article is created.
            <div class="form-group">
                <label asp-for="CreatedAt" class="control-label"></label>
                <input asp-for="CreatedAt" class="form-control" />
                <span asp-validation-for="CreatedAt" class="text-danger"></span>
            </div>
            *@

            @* UpdatedAt is managed by the application.
            <div class="form-group">
                <label asp-for="UpdatedAt" class="control-label"></label>
                <input asp-for="UpdatedAt" class="form-control" />
                <span asp-validation-for="UpdatedAt" class="text-danger"></span>
            </div>
            *@

            <div class="form-group mb-3">
                <label asp-for="IsArchived" class="control-label"></label>
                <input asp-for="IsArchived" class="form-check-input" />
                <span asp-validation-for="IsArchived" class="text-danger"></span>
            </div>

            @*
            @if (User.IsInRole("Editor") || User.IsInRole("Admin"))
            {
                <div class="form-group mb-3">
                    <label asp-for="articleStatus" class="control-label"></label>
                    <input asp-for="articleStatus" class="form-check-input" />
                    <span asp-validation-for="articleStatus" class="text-danger"></span>
                </div>
            }
            *@

            <div class="form-group mb-3">
                <label asp-for="EditorChoice" class="control-label"></label>
                <input asp-for="EditorChoice" class="form-check-input" />
                <span asp-validation-for="EditorChoice" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary">
                    Save
                </button>
            </div>
            <div class="form-group">
                <label asp-for="FrontPagePosition">Front-page position</label>

                <select asp-for="FrontPagePosition" class="form-control">
                    <option value="">Automatic — newest first</option>
                    <option value="1">1 — Main story</option>
                    <option value="2">2 — Second story</option>
                    <option value="3">3 — Third story</option>
                </select>

                <span asp-validation-for="FrontPagePosition"
                      class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a class="btn btn-secondary" asp-action="Articles" asp-controller="Writer">Back to List</a>
            </div>
       
        </div> <!-- END LEFT COLUMN -->
        <!-- RIGHT COLUMN: Image preview and focal-point editor -->
        <div class="col-12 col-lg-5 image-preview-column">
            <h4 class="d-lg-none mobile-column-heading">Image Preview</h4>

            <!-- IMAGE PREVIEW HEADER -->
            <div class="image-preview-header">
                <div>
                    <p id="previewMessage">
                        Select an image to set the focal point.
                    </p>
                </div>

                <div id="focalPointValues">
                    Focal X: <span id="focalXDisplay">50</span>%<br />
                    Focal Y: <span id="focalYDisplay">50</span>%
                </div>
            </div>

            <!-- MAIN NEWS -->
            <div class="image-preview-section">

                <h5>Main News</h5>

                <div id="mainPreviewContainer"
                     class="crop-preview main-preview">

                    <img id="mainImagePreview"
                         src="@Model.ImageUrl"
                         alt="Main news preview" />

                    <div id="mainFocalPointMarker"></div>

                </div>

                <p class="preview-help">
                    Click the image to set the focal point.
                </p>

                <label for="mainZoom">
                    Zoom: <span id="mainZoomDisplay">100%</span>
                </label>

                <input type="range"
                       id="mainZoom"
                       class="zoom-control"
                       min="100"
                       max="300"
                       value="100"
                       step="1" />

                <div id="mainPositionControls">

                    <label for="mainPositionX">
                        Position X: <span id="mainPositionXDisplay">50%</span>
                    </label>

                    <input type="range"
                           id="mainPositionX"
                           class="zoom-control"
                           min="0"
                           max="100"
                           value="50"
                           step="1" />

                    <label for="mainPositionY">
                        Position Y: <span id="mainPositionYDisplay">50%</span>
                    </label>

                    <input type="range"
                           id="mainPositionY"
                           class="zoom-control"
                           min="0"
                           max="100"
                           value="50"
                           step="1" />

                </div>

            </div>

            <!-- SECONDARY AND CATEGORY PREVIEWS -->
            <div class="small-preview-row">

                <!-- SECONDARY PREVIEW -->
                <div class="image-preview-section">

                    <h5>Secondary</h5>

                    <div id="secondaryPreviewContainer"
                         class="crop-preview secondary-preview">

                        <img id="secondaryImagePreview"
                             src="@Model.ImageUrl"
                             alt="Secondary news preview" />

                    </div>

                    <label for="secondaryZoom">
                        Zoom: <span id="secondaryZoomDisplay">100%</span>
                    </label>

                    <input type="range"
                           id="secondaryZoom"
                           class="zoom-control"
                           min="100"
                           max="300"
                           value="100"
                           step="1" />

                </div>

                <!-- CATEGORY PREVIEW -->
                <div class="image-preview-section">

                    <h5>Category</h5>

                    <div id="categoryPreviewContainer"
                         class="crop-preview category-preview">

                        <img id="categoryImagePreview"
                             src="@Model.ImageUrl"
                             alt="Category preview" />

                    </div>

                    <label for="categoryZoom">
                        Zoom: <span id="categoryZoomDisplay">100%</span>
                    </label>

                    <input type="range"
                           id="categoryZoom"
                           class="zoom-control"
                           min="100"
                           max="300"
                           value="100"
                           step="1" />

                </div>

            </div>

        </div>
        <!-- END RIGHT COLUMN -->

    </div>
    <!-- END ROW -->

</form>
</div> <!-- Closes writer-edit-page -->




@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        const imageFile =
            document.getElementById("ImageFile");

        const previewMessage =
            document.getElementById("previewMessage");

        const mainImagePreview =
            document.getElementById("mainImagePreview");

        const mainFocalPointMarker =
            document.getElementById("mainFocalPointMarker");

        const secondaryImagePreview =
            document.getElementById("secondaryImagePreview");

        const categoryImagePreview =
            document.getElementById("categoryImagePreview");


        let mainImageBaseWidth = 0;
        let mainImageBaseHeight = 0;

        let secondaryBaseWidth = 0;
        let secondaryBaseHeight = 0;

        let categoryBaseWidth = 0;
        let categoryBaseHeight = 0;


        const focalPointX =
            document.getElementById("ImageFocalPointX");

        const focalPointY =
            document.getElementById("ImageFocalPointY");

        const focalXDisplay =
            document.getElementById("focalXDisplay");

        const focalYDisplay =
            document.getElementById("focalYDisplay");


        const previews = [
            {
                image: mainImagePreview,
                width: 622,
                height: 310
            },
            {
                image: secondaryImagePreview,
                width: 366,
                height: 100
            },
            {
                image: categoryImagePreview,
                width: 130,
                height: 110
            }
        ];


       
/*
 * IMAGE SELECTION AND PREVIEW INITIALIZATION
 */

let replacementImageUrl = null;

function initializePreviews(imageUrl) {
    const sourceImage = new Image();

    sourceImage.onload = function () {
        const naturalWidth = sourceImage.naturalWidth;
        const naturalHeight = sourceImage.naturalHeight;

        if (!naturalWidth || !naturalHeight) {
            return;
        }

        previews.forEach(function (preview) {
            const image = preview.image;
            const containerWidth = preview.width;
            const containerHeight = preview.height;

            // Scale the image to cover its preview.
            const scale = Math.max(
                containerWidth / naturalWidth,
                containerHeight / naturalHeight
            );

            const displayWidth = naturalWidth * scale;
            const displayHeight = naturalHeight * scale;

            if (image === mainImagePreview) {
                mainImageBaseWidth = displayWidth;
                mainImageBaseHeight = displayHeight;
            }

            if (image === secondaryImagePreview) {
                secondaryBaseWidth = displayWidth;
                secondaryBaseHeight = displayHeight;
            }

            if (image === categoryImagePreview) {
                categoryBaseWidth = displayWidth;
                categoryBaseHeight = displayHeight;
            }

            image.style.width = displayWidth + "px";
            image.style.height = displayHeight + "px";

            image.style.left =
                (containerWidth - displayWidth) / 2 + "px";

            image.style.top =
                (containerHeight - displayHeight) / 2 + "px";

            image.src = imageUrl;
            image.style.display = "block";
        });

        // Restore the saved focal point.
        const x = parseFloat(
            focalPointX.value.replace(",", ".")
        ) || 50;

        const y = parseFloat(
            focalPointY.value.replace(",", ".")
        ) || 50;

        focalPointX.value = x.toFixed(2).replace(".", ",");
        focalPointY.value = y.toFixed(2).replace(".", ",");

        focalXDisplay.textContent = x.toFixed(2);
        focalYDisplay.textContent = y.toFixed(2);

        previewMessage.style.display = "none";

        // Apply the saved zoom and position settings.
        mainZoom.dispatchEvent(new Event("input"));
        secondaryZoom.dispatchEvent(new Event("input"));
        categoryZoom.dispatchEvent(new Event("input"));

        // Show the saved focal point when Edit Article opens.
        mainFocalPointMarker.style.display = "block";
        };

    sourceImage.onerror = function () {
        console.error("Could not load the article image.");
        previewMessage.style.display = "block";
    };

    sourceImage.src = imageUrl;
}

imageFile.addEventListener("change", function () {
    const file = this.files[0];

    // If no file was selected, keep the existing previews.
    if (!file) {
        return;
    }

    // Release the previous temporary preview URL.
    if (replacementImageUrl) {
        URL.revokeObjectURL(replacementImageUrl);
    }

    replacementImageUrl = URL.createObjectURL(file);

    // Use the same preview initialization for replacement images.
    initializePreviews(replacementImageUrl);
});



        /*
         * SECONDARY + CATEGORY FOCAL POINT
         */

        function updateSmallPreviews(x, y)
        {
            applyFocalPoint(
                secondaryImagePreview,
                366,
                100,
                x,
                y
            );


            applyFocalPoint(
                categoryImagePreview,
                130,
                110,
                x,
                y
            );
        }


        function applyFocalPoint(
            image,
            containerWidth,
            containerHeight,
            x,
            y
        )
        {
            const imageWidth =
                image.offsetWidth;

            const imageHeight =
                image.offsetHeight;


            let left =
                containerWidth / 2 -
                imageWidth * x / 100;

            let top =
                containerHeight / 2 -
                imageHeight * y / 100;


            const minLeft =
                containerWidth - imageWidth;

            const minTop =
                containerHeight - imageHeight;


            left =
                Math.max(
                    minLeft,
                    Math.min(0, left)
                );

            top =
                Math.max(
                    minTop,
                    Math.min(0, top)
                );


            image.style.left =
                left + "px";

            image.style.top =
                top + "px";
        }


        mainImagePreview.addEventListener(
            "click",
            setFocalPoint
        );


        function setFocalPoint(event)
        {
            const imageRect =
                mainImagePreview.getBoundingClientRect();


            let x =
                (
                    (event.clientX - imageRect.left) /
                    imageRect.width
                ) * 100;

            let y =
                (
                    (event.clientY - imageRect.top) /
                    imageRect.height
                ) * 100;


            x =
                Math.max(
                    0,
                    Math.min(100, x)
                );

            y =
                Math.max(
                    0,
                    Math.min(100, y)
                );


            focalPointX.value =
                x.toFixed(2).replace(".", ",");

            focalPointY.value =
                y.toFixed(2).replace(".", ",");


            focalXDisplay.textContent =
                x.toFixed(2);

            focalYDisplay.textContent =
                y.toFixed(2);


            mainFocalPointMarker.style.left =
                (
                    mainImagePreview.offsetLeft +
                    mainImagePreview.offsetWidth * x / 100
                ) + "px";

            mainFocalPointMarker.style.top =
                (
                    mainImagePreview.offsetTop +
                    mainImagePreview.offsetHeight * y / 100
                ) + "px";

            mainFocalPointMarker.style.display =
                "block";


            updateSmallPreviews(x, y);
        }


        /*
         * IMAGE POSITION AND ZOOM CONTROLS
         */

        const mainPreviewContainer =
            document.getElementById(
                "mainPreviewContainer"
            );

        const mainPositionX =
            document.getElementById(
                "mainPositionX"
            );

        const mainPositionY =
            document.getElementById(
                "mainPositionY"
            );


        const mainZoom =
            document.getElementById(
                "mainZoom"
            );

        const mainZoomDisplay =
            document.getElementById(
                "mainZoomDisplay"
            );

        const mainPositionXDisplay =
            document.getElementById(
                "mainPositionXDisplay"
            );

        const mainPositionYDisplay =
            document.getElementById(
                "mainPositionYDisplay"
            );


        const secondaryZoom =
            document.getElementById(
                "secondaryZoom"
            );

        const secondaryZoomDisplay =
            document.getElementById(
                "secondaryZoomDisplay"
            );


        const categoryZoom =
            document.getElementById(
                "categoryZoom"
            );

        const categoryZoomDisplay =
            document.getElementById(
                "categoryZoomDisplay"
            );


        /*
         * SECONDARY IMAGE ZOOM
         */

        secondaryZoom.addEventListener(
            "input",
            function()
            {
                const zoom =
                    parseFloat(this.value) / 100;

                const x =
                    parseFloat(
                        focalPointX.value.replace(",", ".")
                    ) || 50;

                const y =
                    parseFloat(
                        focalPointY.value.replace(",", ".")
                    ) || 50;


                secondaryImagePreview.style.width =
                    (
                        secondaryBaseWidth * zoom
                    ) + "px";

                secondaryImagePreview.style.height =
                    (
                        secondaryBaseHeight * zoom
                    ) + "px";


                secondaryZoomDisplay.textContent =
                    this.value + "%";


                document.getElementById(
                    "secondaryImageZoomValue"
                ).value =
                    this.value;


                applyFocalPoint(
                    secondaryImagePreview,
                    366,
                    100,
                    x,
                    y
                );
            }
        );


        /*
         * CATEGORY IMAGE ZOOM
         */

        categoryZoom.addEventListener(
            "input",
            function()
            {
                const zoom =
                    parseFloat(this.value) / 100;

                const x =
                    parseFloat(
                        focalPointX.value.replace(",", ".")
                    ) || 50;

                const y =
                    parseFloat(
                        focalPointY.value.replace(",", ".")
                    ) || 50;


                categoryImagePreview.style.width =
                    (
                        categoryBaseWidth * zoom
                    ) + "px";

                categoryImagePreview.style.height =
                    (
                        categoryBaseHeight * zoom
                    ) + "px";


                categoryZoomDisplay.textContent =
                    this.value + "%";


                document.getElementById(
                    "categoryImageZoomValue"
                ).value =
                    this.value;


                applyFocalPoint(
                    categoryImagePreview,
                    130,
                    110,
                    x,
                    y
                );
            }
        );


        /*
         * MAIN IMAGE POSITION X
         */

        mainPositionX.addEventListener(
            "input",
            function()
            {
                const positionX =
                    parseFloat(this.value);

                mainPositionXDisplay.textContent =
                    positionX + "%";


                document.getElementById(
                    "mainImagePositionXValue"
                ).value =
                    this.value;


                const imageWidth =
                    mainImagePreview.offsetWidth;

                const minLeft =
                    622 - imageWidth;

                const left =
                    minLeft * positionX / 100;


                mainImagePreview.style.left =
                    left + "px";


                const focalX =
                    parseFloat(
                        focalPointX.value.replace(",", ".")
                    ) || 50;

                const focalY =
                    parseFloat(
                        focalPointY.value.replace(",", ".")
                    ) || 50;


                requestAnimationFrame(function()
                {
                    mainFocalPointMarker.style.left =
                        (
                            left +
                            mainImagePreview.offsetWidth *
                            focalX / 100
                        ) + "px";


                    mainFocalPointMarker.style.top =
                        (
                            parseFloat(
                                mainImagePreview.style.top
                            ) +
                            mainImagePreview.offsetHeight *
                            focalY / 100
                        ) + "px";
                });
            }
        );


        /*
         * MAIN IMAGE POSITION Y
         */

        mainPositionY.addEventListener(
            "input",
            function()
            {
                const positionY =
                    parseFloat(this.value);

                mainPositionYDisplay.textContent =
                    positionY + "%";


                document.getElementById(
                    "mainImagePositionYValue"
                ).value =
                    this.value;


                const imageHeight =
                    mainImagePreview.offsetHeight;

                const minTop =
                    310 - imageHeight;

                const top =
                    minTop * positionY / 100;


                mainImagePreview.style.top =
                    top + "px";


                const focalX =
                    parseFloat(
                        focalPointX.value.replace(",", ".")
                    ) || 50;

                const focalY =
                    parseFloat(
                        focalPointY.value.replace(",", ".")
                    ) || 50;


                requestAnimationFrame(function()
                {
                    mainFocalPointMarker.style.left =
                        (
                            parseFloat(
                                mainImagePreview.style.left
                            ) +
                            mainImagePreview.offsetWidth *
                            focalX / 100
                        ) + "px";


                    mainFocalPointMarker.style.top =
                        (
                            top +
                            mainImagePreview.offsetHeight *
                            focalY / 100
                        ) + "px";
                });
            }
        );


        /*
         * MAIN IMAGE ZOOM
         */

        mainZoom.addEventListener(
            "input",
            function()
            {
                const zoom =
                    parseFloat(this.value);

                mainZoomDisplay.textContent =
                    zoom + "%";


                document.getElementById(
                    "mainImageZoomValue"
                ).value =
                    zoom;


                const scale =
                    zoom / 100;

                const newWidth =
                    mainImageBaseWidth * scale;

                const newHeight =
                    mainImageBaseHeight * scale;


                mainImagePreview.style.width =
                    newWidth + "px";

                mainImagePreview.style.height =
                    newHeight + "px";


                const positionX =
                    parseFloat(
                        mainPositionX.value
                    );

                const positionY =
                    parseFloat(
                        mainPositionY.value
                    );


                const minLeft =
                    622 - newWidth;

                const minTop =
                    310 - newHeight;


                const left =
                    minLeft * positionX / 100;

                const top =
                    minTop * positionY / 100;


                mainImagePreview.style.left =
                    left + "px";

                mainImagePreview.style.top =
                    top + "px";


                const focalX =
                    parseFloat(
                        focalPointX.value.replace(",", ".")
                    ) || 50;

                const focalY =
                    parseFloat(
                        focalPointY.value.replace(",", ".")
                    ) || 50;


                mainFocalPointMarker.style.left =
                    (
                        left +
                        newWidth * focalX / 100
                    ) + "px";

                mainFocalPointMarker.style.top =
                    (
                        top +
                        newHeight * focalY / 100
                    ) + "px";


                requestAnimationFrame(function()
                {
                    mainFocalPointMarker.style.left =
                        (
                            left +
                            mainImagePreview.offsetWidth *
                            focalX / 100
                        ) + "px";


                    mainFocalPointMarker.style.top =
                        (
                            top +
                            mainImagePreview.offsetHeight *
                            focalY / 100
                        ) + "px";
                });
            }
        );
       
/*
 * RESTORE SAVED SETTINGS WHEN EDIT OPENS
 */

function getSavedValue(id, fallback) {
    const field = document.getElementById(id);
    const rawValue = field.value.trim().replace(",", ".");
    const value = parseFloat(rawValue);

    return Number.isFinite(value) ? value : fallback;
}

// Restore saved values from the hidden model fields.
mainZoom.value =
    getSavedValue("mainImageZoomValue", 100);

mainPositionX.value =
    getSavedValue("mainImagePositionXValue", 50);

mainPositionY.value =
    getSavedValue("mainImagePositionYValue", 50);

secondaryZoom.value =
    getSavedValue("secondaryImageZoomValue", 100);

categoryZoom.value =
    getSavedValue("categoryImageZoomValue", 100);

// Update the labels to match the sliders.
mainZoomDisplay.textContent = mainZoom.value + "%";
mainPositionXDisplay.textContent = mainPositionX.value + "%";
mainPositionYDisplay.textContent = mainPositionY.value + "%";
secondaryZoomDisplay.textContent = secondaryZoom.value + "%";
categoryZoomDisplay.textContent = categoryZoom.value + "%";

// Load the current article image immediately.
const existingImageUrl = mainImagePreview.getAttribute("src");

if (existingImageUrl && existingImageUrl.trim() !== "") {
    initializePreviews(existingImageUrl);
}


    </script>
}

